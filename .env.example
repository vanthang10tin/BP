# ==========================================
# QC STUDIO & CVAT ALL-IN-ONE CONFIGURATION
# ==========================================

# Host address & CVAT Endpoint
CVAT_HOST=localhost
CVAT_URL=http://127.0.0.1:8080

# Personal Access Token generated from CVAT UI / Database (vanthang10tin@gmail.com)
CVAT_ACCESS_TOKEN=replace-with-a-scoped-expiring-token

# Model integration URLs (internal Docker network by default)
QC_ALLOW_REMOTE_MODEL_ENDPOINTS=true
QC_BBOX_MODEL_URL=http://nuclio-nuclio-custom-yolov8:8080/
QC_SEGMENTATION_MODEL_URL=http://nuclio-nuclio-custom-dinov3-seg:8080/
QC_DINO_BBOX_MODEL_URL=http://nuclio-nuclio-custom-dinov3-detect:8080/
