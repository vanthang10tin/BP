# Safe local defaults. Copy to .env only on a trusted local machine.
HOST=127.0.0.1
PORT=8000
QC_PUBLIC_DEMO=false

# Optional integrations; leave empty until configured locally.
CVAT_URL=http://127.0.0.1:8080
CVAT_ACCESS_TOKEN=
GEMINI_API_KEY=

# Model adapters only permit loopback endpoints unless explicitly reviewed.
QC_ALLOW_REMOTE_MODEL_ENDPOINTS=false
# Optional local weight paths; no download is performed when absent.
# QC_YOLO26_WEIGHTS=C:/path/to/yolo26n.pt
# QC_YOLO26_SEG_WEIGHTS=C:/path/to/yolo26n-seg.pt
