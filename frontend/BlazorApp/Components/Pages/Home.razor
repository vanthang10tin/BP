        catch (Exception ex) { StatusMessage = $"Không tạo được guideline draft: {ex.Message}"; HasError = true; }
    }
    private List<Dictionary<string, object?>> BuildFramesForCvat()
    {
        var output = new List<Dictionary<string, object?>>();
        foreach (var frame in Frames)
        {
            var row = JsonSerializer.Deserialize<Dictionary<string, object?>>(frame.GetRawText()) ?? new();
            var issues = new List<Dictionary<string, object?>>();
            foreach (var issue in GetArray(frame, "errors"))
            {
                var item = JsonSerializer.Deserialize<Dictionary<string, object?>>(issue.GetRawText()) ?? new();
                item["review_status"] = GetIssueDecision(issue);
                issues.Add(item);
            }
            row["errors"] = issues; output.Add(row);
        }
        return output;
    }
    private async Task OnCvatMappingSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(4 * 1024 * 1024); using var reader = new StreamReader(stream); var text = await reader.ReadToEndAsync();
            if (e.File.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            {
                using var doc = JsonDocument.Parse(text); var root = doc.RootElement.TryGetProperty("frame_map", out var map) ? map : doc.RootElement;
                CvatFrameMap = root.EnumerateObject().ToDictionary(p => Path.GetFileName(p.Name), p => p.Value.GetInt32(), StringComparer.OrdinalIgnoreCase);
            }
            else
            {
                var rows = text.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries).Skip(1);
                CvatFrameMap = rows.Select(line => line.Split(',')).Where(cols => cols.Length >= 2)
                    .ToDictionary(cols => Path.GetFileName(cols[0].Trim().Trim('"')), cols => int.Parse(cols[1].Trim().Trim('"')), StringComparer.OrdinalIgnoreCase);
            }
            CvatMappingFileName = e.File.Name; StatusMessage = $"Đã nạp mapping CVAT cho {CvatFrameMap.Count} frame."; HasError = false;
        }
        catch (Exception ex) { CvatFrameMap.Clear(); StatusMessage = $"Mapping CVAT không hợp lệ: {ex.Message}"; HasError = true; }
    }
    private async Task OnJobSelected(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var jid) || jid <= 0)
        {
