    private async Task SaveCvatConfig()
    {
        if (IsCvatConfigSaving) return;
        CvatConfigMessage = null;
        CvatConfigHasError = false;

        CvatUrl = (CvatUrl ?? "").Trim();
        CvatAccessToken = (CvatAccessToken ?? "").Trim();

        if (string.IsNullOrWhiteSpace(CvatUrl))
        {
            CvatConfigMessage = "Vui lòng nhập hoặc chọn CVAT_URL (ví dụ: https://app.cvat.ai)";
            CvatConfigHasError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(CvatAccessToken) && string.IsNullOrWhiteSpace(CvatActiveToken))
        {
            CvatConfigMessage = "Vui lòng dán Personal Access Token từ CVAT vào ô bên trên.";
            CvatConfigHasError = true;
            return;
        }

        IsCvatConfigSaving = true;

        // Auto-detect if user pasted a full CVAT Job URL (e.g. https://app.cvat.ai/tasks/12/jobs/34)
        if (!string.IsNullOrWhiteSpace(CvatUrl))
        {
            var match = System.Text.RegularExpressions.Regex.Match(CvatUrl, @"(https?://[^/]+)/.*jobs/(\d+)");
            if (match.Success)
            {
                CvatUrl = match.Groups[1].Value;
                if (int.TryParse(match.Groups[2].Value, out var parsedJid))
                {
                    CvatJobId = parsedJid;
                }
            }
            else if (CvatUrl.EndsWith("/api", StringComparison.OrdinalIgnoreCase))
            {
                CvatUrl = CvatUrl[..^4];
            }
            CvatUrl = CvatUrl.TrimEnd('/');
        }

        if (!string.IsNullOrWhiteSpace(CvatAccessToken))
        {
            CvatActiveToken = CvatAccessToken.Trim();
        }

        var tokenToSend = !string.IsNullOrWhiteSpace(CvatAccessToken) ? CvatAccessToken : CvatActiveToken;

        try
        {
            using var response = await Api.PostAsJsonAsync("/api/cvat/config", new
            {
                cvat_url = CvatUrl,
                cvat_access_token = tokenToSend
            });

            if (!response.IsSuccessStatusCode)
            {
                var responseText = await response.Content.ReadAsStringAsync();
                var detail = responseText;
                try
                {
                    using var error = JsonDocument.Parse(responseText);
                    detail = GetString(error.RootElement, "detail", responseText);
                }
                catch (JsonException) { }

                // If public demo blocked .env write (403), we still have CvatActiveToken in memory for this session!
                if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    await RefreshCvatConnection();
                    if (CvatReachable)
                    {
                        CvatConfigMessage = "Chế độ Cloud Demo: Token đã được kích hoạt cho phiên làm việc này (không lưu vào .env để bảo mật).";
                        CvatConfigHasError = false;
                    }
                    else
                    {
                        CvatConfigMessage = $"Token kích hoạt cho phiên làm việc, nhưng kết nối thất bại: {CvatConnectionDetail}";
                        CvatConfigHasError = true;
                    }
                    return;
                }

                CvatConfigMessage = $"Could not save CVAT settings: {detail}";
                CvatConfigHasError = true;
                return;
            }

            await RefreshCvatConnection();
            var targetName = IsCvatAi ? "cvat.ai" : "CVAT";
            CvatConfigMessage = CvatReachable
                ? $"Kết nối thành công tới {targetName}! {(string.IsNullOrWhiteSpace(CvatUsername) ? "" : $"Tài khoản: {CvatUsername}")}"
                : $"Đã lưu thiết lập, nhưng chưa kết nối được tới {targetName}: {CvatConnectionDetail}";
            CvatConfigHasError = !CvatReachable;
        }
        catch (HttpRequestException)
        {
            CvatConfigMessage = "Could not reach the QC backend. CVAT settings were not saved.";
            CvatConfigHasError = true;
        }
        catch (TaskCanceledException)
        {
            CvatConfigMessage = "Saving CVAT settings timed out. Check the QC backend and try again.";
            CvatConfigHasError = true;
        }
        finally
        {
            IsCvatConfigSaving = false;
        }
    }
    private async Task PullJobFromCvat()
    {
        if (CvatJobId <= 0)
        {
            StatusMessage = "⚠️ Vui lòng chọn một Job từ danh sách CVAT (hoặc kết nối CVAT) trước khi tải dataset.";
            HasError = true;
            return;
        }
        IsBusy = true;
        StatusMessage = $"Đang nạp annotations và frame metadata từ CVAT Job #{CvatJobId}...";
        try
        {
            var payload = new
            {
                cvat_url = CvatUrl,
                cvat_access_token = !string.IsNullOrWhiteSpace(CvatActiveToken) ? CvatActiveToken : CvatAccessToken,
                download_images = true,
                max_frames = 100
            };
            using var req = CreateCvatRequest(HttpMethod.Post, $"/api/cvat/jobs/{CvatJobId}/pull", payload);
            using var res = await Api.SendAsync(req);
            if (!res.IsSuccessStatusCode)
            {
                var err = await res.Content.ReadAsStringAsync();
                var detail = err;
                try
                {
                    using var error = JsonDocument.Parse(err);
                    detail = GetString(error.RootElement, "detail", err);
                }
                catch (JsonException) { }
                throw new InvalidOperationException(detail);
            }
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            var frames = GetArray(doc.RootElement, "frames");
            var frameMap = GetProperty(doc.RootElement, "frame_map");
            if (frameMap.ValueKind == JsonValueKind.Object)
            {
                CvatFrameMap = frameMap.EnumerateObject().ToDictionary(p => Path.GetFileName(p.Name), p => p.Value.GetInt32(), StringComparer.OrdinalIgnoreCase);
                CvatMappingFileName = $"CVAT Job #{CvatJobId} metadata";
            }
            var imagesProp = GetProperty(doc.RootElement, "images");
            if (imagesProp.ValueKind == JsonValueKind.Object)
            {
                ImageFiles.Clear();
                foreach (var img in imagesProp.EnumerateObject())
                {
                    ImageFiles[img.Name] = img.Value.GetString() ?? "";
                }
            }
            LabelsJson = doc.RootElement.GetProperty("frames").Clone();
            LabelFileName = $"CVAT Job #{CvatJobId} ({frames.Count} frames)";
            WorkspaceName = GetString(doc.RootElement, "task_name", $"CVAT Job #{CvatJobId}");
            StatusMessage = GetString(doc.RootElement, "message", $"Đã nạp {frames.Count} frame từ CVAT Job #{CvatJobId}. Bạn có thể bấm 'Run local QC' để bắt đầu kiểm tra!");
            HasError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Không kéo được dữ liệu từ CVAT: {ex.Message}";
            HasError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }
