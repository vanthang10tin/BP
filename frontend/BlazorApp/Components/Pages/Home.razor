    private async Task PushCvatIssues(bool returnJob = true)
    {
        if (CvatJobId <= 0) { CvatOperationMessage = "⚠️ Vui lòng chọn hoặc nhập CVAT Job ID."; CvatOperationHasError = true; return; }
        if (CvatPushIssueCount == 0) { CvatOperationMessage = "⚠️ Không có issue phù hợp để gửi lên CVAT. Hãy Confirm issue trong bước Review hoặc bật 'Đẩy toàn bộ issue phát hiện'."; CvatOperationHasError = true; return; }
        if (CvatFrameMap.Count == 0 && !ConfirmOffsetMapping) { CvatOperationMessage = "⚠️ Hãy nạp frame map từ CVAT Job hoặc tích chọn xác nhận frame offset trước khi gửi."; CvatOperationHasError = true; return; }
        IsBusy = true;
        CvatJobResultUrl = null;
        CvatOperationSucceeded = false;
        CvatOperationMessage = null;
        CvatOperationHasError = false;
        CvatResultStage = "unchanged";
        CvatResultState = "unchanged";
        HasError = false;
        try
        {
            var payload = new
            {
                cvat_url = CvatUrl,
                cvat_access_token = !string.IsNullOrWhiteSpace(CvatActiveToken) ? CvatActiveToken : CvatAccessToken,
                job_id = CvatJobId,
                frame_offset = CvatFrameOffset,
                frame_map = CvatFrameMap,
                confirm_offset_mapping = ConfirmOffsetMapping || CvatFrameMap.Count > 0,
                assignee_id = CvatAssigneeId > 0 ? CvatAssigneeId : (int?)null,
                sorted_frames = BuildFramesForCvat(),
                update_job_state = returnJob && UpdateJobStateOnReturn,
                target_stage = TargetStage,
                target_state = TargetState,
                include_all_unreviewed = IncludeAllUnreviewed
            };
            using var req = CreateCvatRequest(HttpMethod.Post, "/api/cvat/push-issues", payload);
            using var response = await Api.SendAsync(req);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                var detail = body;
                try
                {
                    using var error = JsonDocument.Parse(body);
                    detail = GetString(error.RootElement, "detail", body);
                }
                catch (JsonException) { }
                throw new InvalidOperationException($"CVAT API HTTP {(int)response.StatusCode}: {detail}");
            }
            using var result = JsonDocument.Parse(body);
            var created = GetInt(result.RootElement, "created", 0);
            var skipped = GetInt(result.RootElement, "skipped_existing", 0);
            var failed = GetArray(result.RootElement, "failed");
            var apiStatus = GetString(result.RootElement, "status", "");
            var responseJobId = GetInt(result.RootElement, "job_id", 0);
            var jobStateChanged = GetBool(result.RootElement, "job_state_changed");
            var requiresJobReturn = returnJob && UpdateJobStateOnReturn;
            var resultUrl = GetString(result.RootElement, "cvat_job_url", "");
            if (Uri.TryCreate(resultUrl, UriKind.Absolute, out var jobUri) && jobUri.Scheme is "http" or "https")
                CvatJobResultUrl = jobUri.ToString();
            CvatResultStage = GetString(result.RootElement, "job_stage", "unchanged");
            CvatResultState = GetString(result.RootElement, "job_state", "unchanged");
            CvatOperationSucceeded = apiStatus == "success" && failed.Count == 0 && responseJobId == CvatJobId && (!requiresJobReturn || jobStateChanged);
            HasError = !CvatOperationSucceeded;
            if (CvatOperationSucceeded)
            {
                CvatOperationMessage = requiresJobReturn
                    ? $"CVAT confirmed Job #{CvatJobId} returned. Created {created} issues; {skipped} duplicates were already present. Stage: {CvatResultStage}; state: {CvatResultState}."
                    : $"CVAT confirmed {created} issues created; {skipped} duplicates were already present. Job state was not changed.";
                CvatStateLabel = requiresJobReturn ? $"JOB RETURNED ({CvatResultState.ToUpperInvariant()})" : "ISSUES PUSHED";
            }
            else
            {
                var failureDetails = failed.Select(item =>
                {
                    var detail = GetString(item, "error", GetString(item, "message", ""));
                    return string.IsNullOrWhiteSpace(detail) ? GetString(item, "frame", "CVAT operation failed") : detail;
                }).Where(detail => !string.IsNullOrWhiteSpace(detail));
                var details = string.Join(" | ", failureDetails);
                CvatOperationMessage = $"CVAT did not confirm a complete operation (status: {apiStatus}, job: #{responseJobId}, created: {created}, duplicates: {skipped})."
                    + (details.Length > 0 ? $" Details: {details}" : "");
                CvatStateLabel = "PARTIAL / NOT CONFIRMED";
            }
            CvatOperationHasError = !CvatOperationSucceeded;
        }
        catch (Exception ex) { CvatJobResultUrl = null; CvatOperationSucceeded = false; CvatOperationMessage = $"Không đẩy được issue lên CVAT: {ex.Message}"; CvatOperationHasError = true; CvatStateLabel = "NOT CONNECTED"; }
        finally { IsBusy = false; }
    }
