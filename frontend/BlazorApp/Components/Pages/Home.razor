        if (raw.Contains("YOLO26-Seg", StringComparison.OrdinalIgnoreCase)) return "YOLO26-Seg";
        if (raw.Contains("SAM2", StringComparison.OrdinalIgnoreCase)) return "SAM2.1";
        if (raw.Contains("DINO", StringComparison.OrdinalIgnoreCase)) return "DINOv3";
        if (raw.Contains("YOLO", StringComparison.OrdinalIgnoreCase)) return "YOLO26";
        if (raw.Contains("Gemini", StringComparison.OrdinalIgnoreCase)) return "Gemini";
        return raw;
    }
    private static string GetString(JsonElement element, string property, string fallback)
    {
        if (element.ValueKind != JsonValueKind.Object || !element.TryGetProperty(property, out var value)) return fallback;
        return value.ValueKind switch { JsonValueKind.String => value.GetString() ?? fallback, JsonValueKind.Number => value.GetRawText(), _ => fallback };
    }
    private static JsonElement GetProperty(JsonElement element, string property) => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var value) ? value : default;
    private static string GetMetric(JsonElement element, string parent, string metric)
    {
        var value = GetProperty(GetProperty(element, parent), metric);
        return value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out var number) ? number.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture) : "—";
    }
    private static int GetInt(JsonElement element, string property, int fallback)
    {
        var value = GetProperty(element, property);
        if (value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var number)) return number;
        return value.ValueKind == JsonValueKind.String && int.TryParse(value.GetString(), out number) ? number : fallback;
    }
    private static double GetDouble(JsonElement element, string property, double fallback)
    {
        var value = GetProperty(element, property);
        if (value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out var number)) return number;
        return value.ValueKind == JsonValueKind.String && double.TryParse(value.GetString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out number) ? number : fallback;
    }
    private static bool GetBool(JsonElement element, string property) => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var v) && v.ValueKind == JsonValueKind.True;
    private static List<JsonElement> GetArray(JsonElement element, string property) => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var v) && v.ValueKind == JsonValueKind.Array ? v.EnumerateArray().Select(x => x.Clone()).ToList() : new();
    private static JsonElement GetObject(JsonElement element, string property) => element.ValueKind == JsonValueKind.Object && element.TryGetProperty(property, out var v) && v.ValueKind == JsonValueKind.Object ? v : default;
    private static string GetStringArray(JsonElement element, string property) => string.Join(", ", GetArray(element, property).Select(x => x.ValueKind == JsonValueKind.String ? x.GetString() : x.ToString()));
    private static (double X, double Y, double W, double H)? GetBox(JsonElement label)
    {
        if (label.ValueKind != JsonValueKind.Object || !label.TryGetProperty("box2d", out var b) || b.ValueKind != JsonValueKind.Object) return null;
        double n(string k) => b.TryGetProperty(k, out var v) && TryNumber(v, out var d) ? d : 0;
        var x = n("x1"); var y = n("y1"); var w = n("x2") - x; var h = n("y2") - y; return w > 0 && h > 0 ? (x, y, w, h) : null;
    }
    private static (double X, double Y, double W, double H)? GetPredictionBox(JsonElement prediction)
    {
        if (prediction.ValueKind != JsonValueKind.Object) return null;
        if (prediction.TryGetProperty("box", out var box) && box.ValueKind == JsonValueKind.Array && box.GetArrayLength() >= 4)
        {
            if (TryNumber(box[0], out var x) && TryNumber(box[1], out var y) && TryNumber(box[2], out var x2) && TryNumber(box[3], out var y2))
            {
                var w = x2 - x; var h = y2 - y;
                if (w > 0 && h > 0) return (x, y, w, h);
            }
        }
        if (prediction.TryGetProperty("points", out var pts) && pts.ValueKind == JsonValueKind.Array && pts.GetArrayLength() >= 4)
        {
            if (TryNumber(pts[0], out var px) && TryNumber(pts[1], out var py) && TryNumber(pts[2], out var px2) && TryNumber(pts[3], out var py2))
            {
                var pw = px2 - px; var ph = py2 - py;
                if (pw > 0 && ph > 0) return (px, py, pw, ph);
            }
        }
        return null;
    }
    private static (double X, double Y, double W, double H)? GetAnyBox(JsonElement el)
    {
        if (el.ValueKind != JsonValueKind.Object) return null;
        if (el.TryGetProperty("box2d", out _)) return GetBox(el);
        if (el.TryGetProperty("box", out _)) return GetPredictionBox(el);
        if (el.TryGetProperty("points", out var pts) && pts.ValueKind == JsonValueKind.Array && pts.GetArrayLength() >= 4)
        {
            if (TryNumber(pts[0], out var x1) && TryNumber(pts[1], out var y1) && TryNumber(pts[2], out var x2) && TryNumber(pts[3], out var y2))
            {
                var w = x2 - x1; var h = y2 - y1;
                if (w > 0 && h > 0) return (x1, y1, w, h);
            }
        }
        return null;
    }
    private (double X, double Y, double W, double H)? GetIssueBox(JsonElement issue)
    {
        var box = GetProperty(issue, "suggested_box");
        if (box.ValueKind == JsonValueKind.Array && box.GetArrayLength() >= 4 && TryNumber(box[0], out var x1) && TryNumber(box[1], out var y1) && TryNumber(box[2], out var x2) && TryNumber(box[3], out var y2) && x2 > x1 && y2 > y1) return (x1, y1, x2 - x1, y2 - y1);
        if (SelectedFrame is not null)
        {
            var objectId = GetString(issue, "object_id", "");
            var label = GetArray(SelectedFrame.Value, "labels").FirstOrDefault(item => GetString(item, "id", "") == objectId);
            if (label.ValueKind == JsonValueKind.Object) return GetBox(label);
        }
        return null;
    }
    private static bool TryNumber(JsonElement value, out double number)
    {
        number = 0;
        return value.ValueKind == JsonValueKind.Number && value.TryGetDouble(out number) && double.IsFinite(number);
    }
    private static string GetPolygonPoints(JsonElement polygon)
    {
        if (polygon.ValueKind != JsonValueKind.Object) return "";
        if (polygon.TryGetProperty("vertices", out var vertices) && vertices.ValueKind == JsonValueKind.Array)
        {
            var points = new List<string>();
            foreach (var point in vertices.EnumerateArray())
                if (point.ValueKind == JsonValueKind.Array && point.GetArrayLength() >= 2 && TryNumber(point[0], out var x) && TryNumber(point[1], out var y))
                    points.Add($"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
            return string.Join(" ", points);
        }
        if (polygon.TryGetProperty("points", out var flatPts) && flatPts.ValueKind == JsonValueKind.Array)
        {
            var points = new List<string>();
            var arr = flatPts.EnumerateArray().ToList();
            for (int i = 0; i + 1 < arr.Count; i += 2)
            {
                if (TryNumber(arr[i], out var x) && TryNumber(arr[i + 1], out var y))
                    points.Add($"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
            }
            return string.Join(" ", points);
        }
        return "";
    }
}
