    private async Task LoadMediaFiles(InputFileChangeEventArgs e, Dictionary<string, string> target, string kind, bool pngOnly)
    {
        if (IsBusy) return;
        IsBusy = true;
        try
        {
            var files = e.GetMultipleFiles(200);
            foreach (var file in files)
            {
                var ext = Path.GetExtension(file.Name).ToLowerInvariant();
                if (pngOnly ? ext != ".png" : ext is not (".png" or ".jpg" or ".jpeg" or ".webp"))
                    throw new InvalidOperationException($"Định dạng không hỗ trợ: {file.Name}.");
                if (file.Size > 10 * 1024 * 1024)
                    throw new InvalidOperationException($"{file.Name} vượt giới hạn 10 MiB mỗi file.");
            }
            var storedBytes = ImageFiles.Values.Concat(MaskFiles.Values).Concat(IndexMaskFiles.Values)
                .Sum(data => (long)data.Length * 3 / 4);
            storedBytes -= files.Where(file => target.ContainsKey(file.Name)).Sum(file => (long)target[file.Name].Length * 3 / 4);
            if (storedBytes + files.Sum(file => file.Size) > 32 * 1024 * 1024)
                throw new InvalidOperationException("Tổng ảnh và mask vượt 32 MiB cho một phiên. Hãy dùng bộ dữ liệu nhỏ hơn hoặc tải lại trang.");
            var pending = new Dictionary<string, string>();
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var mime = Path.GetExtension(file.Name).ToLowerInvariant() switch
                { ".png" => "image/png", ".webp" => "image/webp", _ => "image/jpeg" };
                pending[file.Name] = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            foreach (var pair in pending) target[pair.Key] = pair.Value;
            StatusMessage = $"Đã gắn {target.Count} {kind}.";
            HasError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Không tải được {kind}: {ex.Message}";
            HasError = true;
        }
        finally { IsBusy = false; }
    }
    private async Task RunQc()
    {
        if (IsBusy) return;
        if (LabelsJson is null)
        {
            StatusMessage = "⚠️ Vui lòng tải lên tệp nhãn (Labels JSON) hoặc bấm 'Nạp bộ test 50 ảnh' ở phía trên để bắt đầu.";
            HasError = true;
            return;
        }
        if (string.IsNullOrWhiteSpace(GuidelineText))
        {
            await LoadDefaultGuideline();
        }
        IsBusy = true; HasError = false; StatusMessage = null;
        try
        {
            await EnsureWorkspace();
            var data = LabelsJson.Value;
            var images = ImageFiles.ToDictionary(pair => pair.Key, pair => pair.Value);
            var payload = new Dictionary<string, object?> { ["workspace_id"] = WorkspaceId, ["task_type"] = Mode == "segmentation" ? "semantic_segmentation" : "bbox", ["data"] = data, ["images"] = images, ["use_gemini"] = UseGemini, ["gemini_frame_limit"] = Math.Clamp(GeminiFrameLimit, 1, 50) };
            if (Mode == "segmentation")
            {
                var rows = LabelsJson.Value.ValueKind == JsonValueKind.Array ? LabelsJson.Value.EnumerateArray().Select(x => x.Clone()).ToList() : GetArray(LabelsJson.Value, "data");
                foreach (var row in rows)
                {
                    var name = GetString(row, "name", "");
                    var indexPath = GetString(row, "mask_index", "");
                    var colorPath = GetString(row, "mask_color", "");
                    var indexName = Path.GetFileName(indexPath.Replace('/', Path.DirectorySeparatorChar));
                    var colorName = Path.GetFileName(colorPath.Replace('/', Path.DirectorySeparatorChar));
                    if (string.IsNullOrWhiteSpace(name) || !ImageFiles.ContainsKey(name)) throw new InvalidOperationException($"Thiếu ảnh JPG tương ứng cho frame '{name}'. Chọn toàn bộ ảnh images/.");
                    if (string.IsNullOrWhiteSpace(indexName) || !IndexMaskFiles.ContainsKey(indexName)) throw new InvalidOperationException($"Thiếu train-ID mask cho frame '{name}'. Chọn PNG từ masks/index/.");
                    if (string.IsNullOrWhiteSpace(colorName) || !MaskFiles.ContainsKey(colorName)) throw new InvalidOperationException($"Thiếu color mask cho frame '{name}'. Chọn PNG từ masks/color/.");
                }
                payload["masks"] = IndexMaskFiles.ToDictionary(pair => pair.Key, pair => pair.Value);
            }
            using var response = await Api.PostAsJsonAsync("/api/qc/run", payload);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(body);
            using var doc = JsonDocument.Parse(body); ResultRoot = doc.RootElement.Clone(); Frames = GetArray(ResultRoot, "sorted_frames");
            if (Frames.Count == 0) throw new InvalidOperationException("API không trả về frame nào. Kiểm tra profile, taxonomy và mask mapping.");
            IssueDecisions.Clear(); SelectedFrameName = GetString(Frames[0], "frame_name", ""); SelectedFrame = Frames[0]; Step = 1; ApiOnline = true; ShowModelMask = false;
            if (ResultRoot.TryGetProperty("taxonomy_alignment", out var taxAlign) && taxAlign.ValueKind == JsonValueKind.Object)
            {
                TaxonomyAlignment = taxAlign.Clone();
            }
            var models = GetArray(ResultRoot, "models");
            var skipped = GetArray(ResultRoot, "model_skips").Count;
            var modelIssues = GetInt(ResultRoot, "model_issues", 0);
            if (models.Count == 0 && skipped > 0)
            {
                StatusMessage = $"Đã chạy QC Tầng 1 (Luật). Lưu ý: Chưa kết nối Model AI ({skipped} frame bỏ qua AI do model offline hoặc chưa cấu hình).";
            }
            else
            {
                var modelNames = string.Join(", ", models.Select(m => GetString(m, "name", "AI")));
                StatusMessage = UseGemini
                    ? $"Đã chạy QC + Gemini {GeminiModel}: {modelIssues} candidate issues tổng cộng. Mọi đề xuất cần người xác nhận."
                    : Mode == "segmentation"
                    ? $"Đã chạy Segmentation AI ({modelNames}): {modelIssues} candidate issues."
                    : $"Đã chạy QC + Model AI ({modelNames}): {modelIssues} candidate issues; {skipped} frame chưa có ảnh/model result. Candidate cần người xác nhận.";
            }
        }
        catch (Exception ex) { StatusMessage = $"Phân tích thất bại: {ex.Message}"; HasError = true; }
        finally { IsBusy = false; }
    }
