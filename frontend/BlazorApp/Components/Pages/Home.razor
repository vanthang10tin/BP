@page "/"
@using System.Text.Json
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>QC Studio · Local Dataset QA</PageTitle>

<div class="studio-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="QC Studio home"><span class="brand-mark">Q</span><span>QC<span class="brand-light"> STUDIO</span><small>LOCAL DATASET QUALITY WORKSPACE</small></span></a>
        <div class="topbar-center"><span class="live-dot"></span><span>@(ApiOnline ? "Local QC engine connected" : "Waiting for QC engine")</span><span class="privacy-chip"><i class="bi bi-shield-lock"></i> LOCAL WORKSPACE</span></div>
        <div class="topbar-right"><span class="avatar">VT</span><span class="user-label">Reviewer workspace</span></div>
    </header>

    <div class="service-status" role="status">@(ApiOnline ? "QC API đã kết nối" : "Chưa kết nối được QC API") <button type="button" class="text-button" disabled="@IsConnecting" @onclick="RefreshServices">@(IsConnecting ? "Đang kiểm tra…" : "Kiểm tra kết nối")</button></div>
    <div class="app-frame">
        <aside class="right-rail" aria-label="Workspace navigation">
            <div class="rail-label">LABEL TYPE</div>
            <button class="rail-choice @(Mode == "bbox" ? "selected" : "")" @onclick='() => SetMode("bbox")'><i class="bi bi-bounding-box"></i><span>BBox</span></button>
            <button class="rail-choice @(Mode == "segmentation" ? "selected" : "")" @onclick='() => SetMode("segmentation")'><i class="bi bi-mask"></i><span>Segmentation</span></button>
            <div class="rail-divider"></div>
            <div class="rail-label">WORKSPACE</div>
            <button class="rail-step @(Step == 0 ? "active" : "")" @onclick="() => Step = 0"><b>01</b><span>Prepare</span></button>
            <button class="rail-step @(Step == 1 ? "active" : "")" @onclick="() => Step = 1"><b>02</b><span>Review</span>@if (Frames.Count > 0) { <em>@Frames.Count</em> }</button>
            <button class="rail-step @(Step == 2 ? "active" : "")" @onclick="() => Step = 2"><b>03</b><span>Export</span></button>
            <div class="rail-spacer"></div>
            <div class="engine-state"><span class="engine-icon"><i class="bi bi-cpu"></i></span><span>QC engine<small>@ModelStatusText</small></span><span class="engine-dot"></span></div>
        </aside>

        <main class="workspace">
            @if (Step == 0)
            {
                <section class="welcome-row"><div><div class="eyebrow">QUALITY CONTROL / @Mode.ToUpperInvariant()</div><h1>Prepare a review run</h1><p>Load annotations, a team guideline and paired images/masks. Local models compare predictions with labels and create review candidates.</p></div><span class="step-counter">01 <i>/ 03</i></span></section>
                <div class="demo-quick-banner" style="background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(16,185,129,0.1)); border: 1px solid #6366f1; border-radius: 9px; padding: 13px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 15px; flex-wrap: wrap;">
                    <div>
                        <b style="color: #c7d2fe; font-size: 13px; display: flex; align-items: center; gap: 7px;">
                            <i class="bi bi-lightning-charge-fill" style="color: #fbbf24;"></i> Thử nhanh với lát cắt BDD100K thật
                        </b>
                        <p style="margin: 4px 0 0; color: #94a3b8; font-size: 11px;">Nạp 50 frame/ảnh thật từ bộ test cục bộ để thử giao diện. Guideline đi kèm chỉ là mẫu tham khảo, chưa được dự án phê duyệt.</p>
                    </div>
                    <button class="primary-button" style="white-space: nowrap; padding: 10px 18px; font-weight: 600;" disabled="@IsBusy" @onclick="LoadQuickDemoPack">
                        <i class="bi bi-box-arrow-in-down"></i> Nạp bộ test 50 ảnh
                    </button>
                </div>
                <div class="setup-grid">
                    <article class="setup-card"><div class="card-head"><span class="card-icon violet"><i class="bi bi-box-arrow-in-down"></i></span><span class="card-kicker">INPUT 01</span><span class="required">REQUIRED</span></div><h2>@(Mode == "segmentation" ? "Segmentation manifest" : "Dataset & labels")</h2><p>@(Mode == "segmentation" ? "Upload an image manifest with paired train-ID masks and images. Color masks are used for a visual overlay." : "Upload BDD100K, COCO, YOLO-JSON, or normalized frame annotations. Attach source images for local model inference.")</p>
                        <label class="dropzone" for="labels-file"><InputFile id="labels-file" OnChange="OnLabelsSelected" accept=".json,application/json" /><span class="upload-symbol"><i class="bi bi-file-earmark-arrow-up"></i></span><strong>@(LabelFileName ?? "Choose annotation JSON")</strong><small>@(LabelFileName is null ? "BDD100K labels · JSON" : $"{FrameCount} frames parsed · ready to analyze")</small><span class="browse-button">Browse files</span></label>
                        <div class="file-meta"><span><i class="bi bi-braces"></i> @(ProfileJson is null ? "BDD100K default · profile selects other formats" : GetString(ProfileJson.Value, "annotation_format", "custom profile"))</span><span><i class="bi bi-lock"></i> Stays in this workspace</span></div>
                        <label class="compact-upload" for="profile-file" style="margin-top:12px;width:100%;justify-content:space-between"><InputFile id="profile-file" OnChange="OnProfileSelected" accept=".json,application/json" /><i class="bi bi-braces"></i><span>@(ProfileFileName ?? "Add dataset profile")</span><small>format · ontology · thresholds</small></label>
                    </article>
                    <article class="setup-card"><div class="card-head"><span class="card-icon mint"><i class="bi bi-journal-check"></i></span><span class="card-kicker">INPUT 02</span><span class="required" style="background:#1e293b;color:#38bdf8;border:1px solid #0284c7">MẶC ĐỊNH / SẴN CÓ</span></div><h2>Quy chuẩn Guideline</h2><p>Hệ thống có sẵn <b>Quy chuẩn mặc định QC Studio</b> (độ khít IoU &ge; 0.50, giới hạn viền, kích thước tối thiểu, trùng box). Nếu bạn có guideline riêng, hãy tải lên để Gemini tự động trích xuất và điều chỉnh luật.</p>
                        <label class="dropzone guideline-drop" for="guideline-file"><InputFile id="guideline-file" OnChange="OnGuidelineSelected" accept=".md,.txt,text/plain,text/markdown" /><span class="upload-symbol"><i class="bi bi-journal-arrow-up"></i></span><strong>@(GuidelineFileName ?? "Guideline Hệ Thống (Mặc định)")</strong><small>@(GuidelineFileName is null ? "Quy chuẩn nội bộ QC Studio đang kích hoạt" : $"{GuidelineFileName} · Đã nạp guideline")</small><span class="browse-button secondary">Tải guideline khác</span></label>
                        <div class="file-meta"><span><i class="bi bi-bookmark-check"></i> Điều khoản áp dụng</span><button class="text-button" @onclick="OpenGuideline">Xem / Sửa guideline <i class="bi bi-arrow-up-right"></i></button></div>
                    </article>
                    <article class="setup-card cvat-config-card">
                        <div class="card-head"><span class="card-icon mint"><i class="bi bi-plug"></i></span><span class="card-kicker">CVAT INTEGRATION</span><span class="required">CLOUD & LOCAL</span></div>
                        <h2>Connect to CVAT</h2>
                        <p>Hỗ trợ kết nối cả <b>Cloud CVAT (cvat.ai)</b> lẫn <b>Local CVAT</b> qua Personal Access Token.</p>

                        <div class="cvat-presets">
                            <button type="button" class="preset-btn @(IsCvatAi ? "active" : "")" @onclick="SelectCvatAiPreset">
                                <i class="bi bi-cloud-check"></i> Cloud CVAT (cvat.ai)
                            </button>
                            <button type="button" class="preset-btn @(IsLocalCvat ? "active" : "")" @onclick="SelectLocalCvatPreset">
                                <i class="bi bi-pc-display"></i> Local CVAT (localhost:8080)
                            </button>
                        </div>

                        @if (IsCvatAi)
                        {
                            <div class="cvat-guide-box">
                                <div style="font-weight:600;margin-bottom:4px"><i class="bi bi-key-fill" style="color:#a78bfa"></i> Cách lấy Token trên cvat.ai:</div>
                                <ol>
                                    <li>Đăng nhập <a href="https://app.cvat.ai" target="_blank" rel="noopener noreferrer">app.cvat.ai</a></li>
                                    <li>Bấm <b>Avatar</b> góc phải trên ➔ chọn <b>Personal access tokens</b></li>
                                    <li>Bấm <b>Create</b> ➔ đặt tên token ➔ Copy chuỗi token và dán vào ô bên dưới.</li>
                                </ol>
                            </div>
                        }
                        else if (IsLocalCvat)
                        {
                            <div class="cvat-guide-box warning">
                                <i class="bi bi-exclamation-triangle"></i> <span>Local CVAT chỉ kết nối được khi chạy app trên máy cá nhân. Nếu bạn đang mở web từ Cloud (Render), hãy dùng <b>Cloud CVAT (cvat.ai)</b> hoặc public tunnel.</span>
                            </div>
                        }

                        <label>CVAT_URL
                            <input type="url" @bind="CvatUrl" @bind:event="oninput" @onkeydown="OnCvatKeydown" placeholder="https://app.cvat.ai" autocomplete="url" />
                        </label>
                        <label>CVAT_ACCESS_TOKEN (Personal Access Token)
                            <input type="password" @bind="CvatAccessToken" @bind:event="oninput" @onkeydown="OnCvatKeydown" placeholder="Dán mã Token từ CVAT vào đây" autocomplete="new-password" />
                        </label>
                        <div class="cvat-config-footer">
                            <button type="button" class="primary-button" disabled="@IsCvatConfigSaving" @onclick="SaveCvatConfig">
                                @(IsCvatConfigSaving ? "Đang kết nối…" : "Connect & Save CVAT") <i class="bi bi-shield-lock"></i>
                            </button>
                            <small>@(CvatReachable ? (string.IsNullOrWhiteSpace(CvatUsername) ? "Connected" : $"Connected ({CvatUsername})") : "Sẵn sàng kết nối")</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(CvatConfigMessage))
                        {
                            <div class="cvat-config-message @(CvatConfigHasError ? "error" : "")" role="status">@CvatConfigMessage</div>
                        }
                    </article>
                    <article class="setup-card cvat-jobs-card">
                        <div class="card-head"><span class="card-icon mint"><i class="bi bi-kanban"></i></span><span class="card-kicker">CVAT REVIEW & JOBS</span></div>
                        <h2>Select a CVAT job</h2>
                        <p>Chọn một Job từ instance CVAT đã kết nối để mở trang review hoặc nạp trực tiếp vào workspace.</p>
                        <div class="file-meta">
                            <span><i class="bi bi-plug"></i> @CvatStateLabel</span>
                            @if (!string.IsNullOrWhiteSpace(CvatUsername))
                            {
                                <span><i class="bi bi-person-check"></i> @CvatUsername</span>
                            }
                        </div>
                        @if (!CvatReachable)
                        {
                            <small>@(string.IsNullOrWhiteSpace(CvatConnectionDetail) ? "Connect to CVAT above and save its settings to load jobs." : CvatConnectionDetail)</small>
                        }
                        else if (CvatJobList.Count == 0)
                        {
                            <small>Không tìm thấy Job nào trên CVAT. Hãy kiểm tra quyền của Token hoặc bấm 'Refresh jobs'.</small>
                        }
                        else
                        {
                            <label for="setup-cvat-job">CVAT job</label>
                            <select id="setup-cvat-job" class="cvat-job-select" @onchange="OnJobSelected">
                                <option value="0">-- Select a job --</option>
                                @foreach (var job in CvatJobList)
                                {
                                    var jobId = GetInt(job, "id", 0);
                                    var taskName = GetString(job, "task_name", "Task");
                                    var frameCount = GetInt(job, "frame_count", 0);
                                    <option value="@jobId" selected="@(CvatJobId == jobId)">Job #@jobId · @taskName (@frameCount frames)</option>
                                }
                            </select>
                        }
                        <div class="cvat-config-footer">
                            <button type="button" class="outline-button" disabled="@IsBusy" @onclick="LoadCvatJobs"><i class="bi bi-arrow-clockwise"></i> Refresh jobs</button>
                            <button type="button" class="primary-button" disabled="@IsBusy" @onclick="PullJobFromCvat" style="background:#059669;border-color:#059669"><i class="bi bi-cloud-arrow-down"></i> Tải Dataset từ CVAT Job</button>
                            @if (CvatSelectedJobUrl is not null)
                            {
                                <a class="primary-button" href="@CvatSelectedJobUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-arrow-right"></i> Mở trên CVAT</a>
                            }
                        </div>
                    </article>
                    <article class="setup-card image-card"><div class="card-head"><span class="card-icon amber"><i class="bi bi-images"></i></span><span class="card-kicker">@(Mode == "segmentation" ? "REQUIRED IMAGE + MASK PAIR" : "IMAGE INPUT")</span></div><h2>Frame images & masks</h2><p>@(Mode == "segmentation" ? "Attach JPGs, train-ID masks for metric comparison, and color masks for display." : "Attach matching images for local model inference. BDD100K archive lookup is a fallback.")</p><label class="compact-upload" for="images-file"><InputFile id="images-file" OnChange="OnImagesSelected" accept="image/*" multiple /><i class="bi bi-plus-lg"></i><span>@(ImageFiles.Count == 0 ? "Add images" : $"{ImageFiles.Count} images attached")</span><small>match by filename</small></label>@if (Mode == "segmentation") { <label class="compact-upload mask-upload" for="index-masks-file"><InputFile id="index-masks-file" OnChange="OnIndexMasksSelected" accept="image/png" multiple /><i class="bi bi-grid-3x3"></i><span>@(IndexMaskFiles.Count == 0 ? "Add train-ID masks" : $"{IndexMaskFiles.Count} index masks")</span><small>PNG · masks/index/</small></label><label class="compact-upload mask-upload" for="masks-file"><InputFile id="masks-file" OnChange="OnMasksSelected" accept="image/png" multiple /><i class="bi bi-layers"></i><span>@(MaskFiles.Count == 0 ? "Add color masks" : $"{MaskFiles.Count} color masks")</span><small>PNG · masks/color/</small></label> }</article>
                </div>
                @if (TaxonomyAlignment is not null)
                {
                    var activeList = GetArray(TaxonomyAlignment.Value, "active_classes");
                    var unsupList = GetArray(TaxonomyAlignment.Value, "unsupported_guideline_classes");
                    var exclList = GetArray(TaxonomyAlignment.Value, "excluded_model_classes");
                    var summary = GetString(TaxonomyAlignment.Value, "summary", "");
                    var cov = GetDouble(TaxonomyAlignment.Value, "model_coverage_percent", 100.0);

                    <div class="taxonomy-alignment-card" style="margin-top:14px;padding:16px;background:linear-gradient(135deg, #101725, #0d131f);border:1px solid #2a3a50;border-radius:10px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <span style="background:rgba(129, 140, 248, 0.15);color:#a5b4fc;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;letter-spacing:0.5px">
                                    <i class="bi bi-diagram-3-fill"></i> MODEL CAPABILITY MATRIX
                                </span>
                                <span style="font-size:13px;font-weight:600;color:#f1f5f9">Đối Soát Danh Mục Nhãn & Năng Lực Model (theo metadata provider)</span>
                            </div>
                            <span style="font-size:11px;color:#38bdf8;background:rgba(56, 189, 248, 0.12);padding:3px 9px;border-radius:6px;border:1px solid rgba(56, 189, 248, 0.25)">
                                Độ phủ Model: <b>@(GetString(TaxonomyAlignment.Value, "status", "") == "verified" ? $"{cov}%" : "Chưa xác minh")</b>
                            </span>
                        </div>

                        <p style="font-size:11px;color:#94a3b8;line-height:1.55;margin:0 0 12px 0;">
                            <i class="bi bi-stars" style="color:#f59e0b;margin-right:4px;"></i> @summary
                        </p>

                        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:12px;">
                            <div style="background:#090d14;border:1px solid #1e293b;border-radius:8px;padding:10px;">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                                    <span style="color:#4ade80;font-size:11px;font-weight:700;"><i class="bi bi-check-circle-fill"></i> Model AI Khảo Sát (@activeList.Count)</span>
                                    <small style="color:#64748b;font-size:9px">Theo model đã cấu hình</small>
                                </div>
                                <div style="display:flex;flex-wrap:wrap;gap:5px;">
                                    @foreach (var c in activeList)
                                    {
                                        <span style="background:rgba(74, 222, 128, 0.12);color:#86efac;border:1px solid rgba(74, 222, 128, 0.25);padding:2px 7px;border-radius:4px;font-size:10px;font-family:'DM Mono',monospace;">@c</span>
                                    }
                                </div>
                            </div>

                            <div style="background:#090d14;border:1px solid #1e293b;border-radius:8px;padding:10px;">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                                    <span style="color:#facc15;font-size:11px;font-weight:700;"><i class="bi bi-eye-slash-fill"></i> Điểm Mù Model (@unsupList.Count)</span>
                                    <small style="color:#64748b;font-size:9px">Luật vật lý + Thủ công</small>
                                </div>
                                <div style="display:flex;flex-wrap:wrap;gap:5px;">
                                    @if (unsupList.Count == 0)
                                    {
                                        <span style="color:#64748b;font-size:10px;font-style:italic">Chưa ghi nhận; xem trạng thái xác minh.</span>
                                    }
                                    else
                                    {
                                        @foreach (var c in unsupList)
                                        {
                                            <span style="background:rgba(250, 204, 21, 0.12);color:#fde047;border:1px solid rgba(250, 204, 21, 0.25);padding:2px 7px;border-radius:4px;font-size:10px;font-family:'DM Mono',monospace;">@c</span>
                                        }
                                    }
                                </div>
                            </div>

                            <div style="background:#090d14;border:1px solid #1e293b;border-radius:8px;padding:10px;">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                                    <span style="color:#94a3b8;font-size:11px;font-weight:700;"><i class="bi bi-funnel-fill"></i> Tự Động Lọc Bỏ (@exclList.Count)</span>
                                    <small style="color:#64748b;font-size:9px">Không gây rối</small>
                                </div>
                                <div style="display:flex;flex-wrap:wrap;gap:5px;max-height:55px;overflow-y:auto;">
                                    @foreach (var c in exclList.Take(12))
                                    {
                                        <span style="background:rgba(148, 163, 184, 0.1);color:#94a3b8;border:1px solid rgba(148, 163, 184, 0.2);padding:1px 6px;border-radius:4px;font-size:9px;font-family:'DM Mono',monospace;">@c</span>
                                    }
                                    @if (exclList.Count > 12)
                                    {
                                        <span style="color:#64748b;font-size:9px;padding:2px;">+@(exclList.Count - 12) nhãn khác</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="status-message @(HasError ? "error" : "")"><i class="bi @(HasError ? "bi-exclamation-circle" : "bi-check-circle")"></i> @StatusMessage</div> }
                <div class="setup-footer"><div class="privacy-note"><i class="bi bi-shield-check"></i><span><b>@(UseGemini ? "QC + Gemini review" : ModelsMode == "remote" ? "Modal Cloud review" : "Local-only review")</b><small>@(UseGemini ? "Gemini nhận ảnh có bất đồng để phân xử. Model Modal vẫn nhận ảnh nếu đã được cấu hình." : ModelsMode == "remote" ? "Ảnh được gửi tới Modal Cloud đã cấu hình; Không gửi ảnh tới Gemini." : "Ảnh chỉ gửi tới model local trên loopback; Không gửi ảnh tới Gemini.") @(Mode == "segmentation" ? "Cần ảnh + train-ID mask; kết quả IoU là candidate để người review." : "Model findings là candidate để người review.") Số lượng candidate có thể khác giữa máy do model/weights local khác nhau.</small></span></div><button class="primary-button" disabled="@IsBusy" @onclick="RunQc">@(IsBusy ? "Analyzing…" : UseGemini ? "Run QC + Gemini" : ModelsMode == "remote" ? "Run QC + Modal" : "Run local QC") <i class="bi bi-arrow-right"></i></button></div>
                <div class="setup-card" style="margin-top:12px;padding:16px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
                    <label style="display:flex;align-items:flex-start;gap:10px;margin:0;max-width:760px"><input type="checkbox" @bind="UseGemini" disabled="@(IsBusy || !GeminiConfigured)" style="margin-top:3px"/><span><b>Kết hợp Gemini vision vào pipeline</b><small style="display:block;color:#94a3b8;margin-top:4px">@(GeminiConfigured ? $"Chỉ gửi ảnh khi bạn bật tùy chọn này (Model: {GeminiModel})." : "Gemini chưa được cấu hình. Thêm GEMINI_API_KEY vào biến môi trường.") Gemini tạo candidate để reviewer xác nhận.</small><small style="display:block;color:#fbbf24;margin-top:4px">Khi được chọn, ảnh và guideline sẽ được gửi tới Google. Chọn số frame bên cạnh để giới hạn.</small></span></label>
                    <label style="margin:0;max-width:180px">Số frame tối đa<input type="number" min="1" max="50" @bind="GeminiFrameLimit" disabled="@(!UseGemini || IsBusy)" /></label>
                </div>
            }
            else if (Step == 1)
            {
                <section class="welcome-row compact-welcome"><div><div class="eyebrow">REVIEW QUEUE / @Mode.ToUpperInvariant()</div><h1>Prioritized review</h1><p>Highest-risk frames first · Select an issue to inspect its evidence.</p></div><div class="review-heading-actions"><span>@($"{GetString(ResultRoot, "guideline_status", "no guideline")} · v{GetInt(ResultRoot, "guideline_version", 0)}")</span><button class="outline-button" @onclick="OpenGuideline"><i class="bi bi-journal-text"></i> Search / edit guideline</button><button class="primary-button" style="background:#ef4444;border-color:#dc2626;font-size:9px" @onclick="() => Step = 2"><i class="bi bi-arrow-right"></i> Reports (@IssueCount)</button></div></section>
                @if (Frames.Count == 0)
                { <div class="empty-state"><span class="empty-icon"><i class="bi bi-inboxes"></i></span><h2>No review run yet</h2><p>Upload labels in Prepare, then start an analysis run.</p><button class="primary-button" @onclick="() => Step = 0">Go to Prepare <i class="bi bi-arrow-right"></i></button></div> }
                else
                {
                    <div class="metrics-row"><div class="metric"><small>FRAMES IN RUN</small><b>@Frames.Count</b></div><div class="metric"><small>@(Mode == "segmentation" ? "MACRO IoU" : "FRAMES WITH CANDIDATES")</small><b>@(Mode == "segmentation" ? GetMetric(ResultRoot, "summary", "macro_iou") : ReviewCount.ToString())</b></div><div class="metric"><small>MODEL CANDIDATES</small><b>@GetInt(ResultRoot, "model_issues", 0)</b></div><div class="metric metric-pass"><small>REVIEW DECISIONS</small><b>@TotalDecidedCount / @IssueCount</b><span style="display:block;font-size:9px;color:#94a3b8;margin-top:2px;font-family:'DM Mono',monospace">(@ConfirmedIssueCount đã giữ · @RejectedIssueCount đã xóa)</span></div><div class="metric-source"><i class="bi bi-info-circle"></i>@ModelStatusText · @(GetBool(GetObject(ResultRoot, "gemini"), "used") ? "Gemini + local candidates" : "local-only candidates") · human review required · IoU is not a benchmark</div></div>
                    @if (TaxonomyAlignment is not null)
                    {
                        var activeList = GetArray(TaxonomyAlignment.Value, "active_classes");
                        var unsupList = GetArray(TaxonomyAlignment.Value, "unsupported_guideline_classes");
                        var exclList = GetArray(TaxonomyAlignment.Value, "excluded_model_classes");
                        <div style="margin: 8px 0 12px; padding: 10px 14px; background: #0c121b; border: 1px solid #233142; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 12px; font-size: 11px; flex-wrap: wrap;">
                                <span style="color: #4ade80; font-weight: 700;"><i class="bi bi-check-circle-fill"></i> AI Khảo Sát (@activeList.Count): <span style="font-weight:400;color:#cbd5e1">@string.Join(", ", activeList)</span></span>
                                @if (unsupList.Count > 0)
                                {
                                    <span style="color: #facc15; font-weight: 700;"><i class="bi bi-exclamation-triangle-fill"></i> Điểm Mù (@unsupList.Count): <span style="font-weight:400;color:#fef08a">@string.Join(", ", unsupList) (QC bằng Luật)</span></span>
                                }
                            </div>
                            <span style="font-size: 10px; color: #94a3b8; font-family: 'DM Mono', monospace;">Đã tự động loại trừ @exclList.Count class ngoài dự án</span>
                        </div>
                    }
                    <div class="review-layout">
                        <section class="queue-panel"><div class="panel-title"><div><span class="eyebrow">FRAME QUEUE</span><h2>@(Mode == "segmentation" ? "Mask review" : "Review priority")</h2></div><span class="sort-label"><i class="bi @(Mode == "segmentation" ? "bi-images" : "bi-sort-down")"></i> @(Mode == "segmentation" ? "Pack order" : "Rule flags first")</span></div>@if (Mode == "segmentation") { <div class="queue-filters"><span class="filter-pill on">All mask pairs <span>@Frames.Count</span></span></div> } else { <div class="queue-filters"><button class="filter-pill @(QueueFilter == "all" ? "on" : "")" @onclick='() => QueueFilter = "all"'>All <span>@Frames.Count</span></button><button class="filter-pill @(QueueFilter == "review" ? "on" : "")" @onclick='() => QueueFilter = "review"'>Flagged <span>@ReviewCount</span></button><button class="filter-pill @(QueueFilter == "pass" ? "on" : "")" @onclick='() => QueueFilter = "pass"'>No rule flags <span>@PassCount</span></button></div>}
                        <div class="frame-list">@foreach (var frame in VisibleFrames)
                            { var name = GetString(frame, "frame_name", "frame"); var rank = GetInt(frame, "priority_rank", 4); var issues = GetArray(frame, "errors"); <button class="frame-row @(SelectedFrameName == name ? "chosen" : "")" @onclick="() => SelectFrame(name)"><span class="rank-mark rank-@rank">@(Mode == "segmentation" ? "M" : rank)</span><span class="frame-copy"><b>@name</b><small>@(Mode == "segmentation" ? $"Macro IoU {GetMetric(frame, "model_segmentation_metrics", "macro_iou")} · {issues.Count} candidate(s)" : $"{GetString(frame, "priority_label", "NO RULE FLAGS")} · {issues.Count} candidate(s)")</small></span><span class="queue-severity"><i class="bi bi-exclamation-circle"></i> @issues.Count</span></button> }</div>
                        </section>
                        <section class="canvas-panel @(IsFullscreen ? "is-fullscreen" : "")">
                            <div class="panel-title image-panel-title">
                                <div>
                                    <span class="eyebrow">ANNOTATION CANVAS · @Mode.ToUpperInvariant()</span>
                                    <h2>@SelectedFrameName</h2>
                                </div>
                                <div class="zoom-controls">
                                    <button class="zoom-btn" title="Thu nhỏ (Zoom out)" @onclick="ZoomOut"><i class="bi bi-dash-lg"></i></button>
                                    <button class="zoom-btn" title="Đặt lại 100%" @onclick="FitView" style="width:auto;padding:0 6px;font-size:10px">@($"{Math.Round(ZoomLevel * 100)}%")</button>
                                    <button class="zoom-btn" title="Phóng to (Zoom in)" @onclick="ZoomIn"><i class="bi bi-plus-lg"></i></button>
                                    <button class="zoom-btn @(IsFullscreen ? "active" : "")" title="@(IsFullscreen ? "Thoát toàn màn hình (ESC)" : "Xem toàn màn hình (Fullscreen)")" @onclick="ToggleFullscreen">
                                        <i class="bi @(IsFullscreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                                    </button>
                                    @if (IsFullscreen)
                                    {
                                        <button class="layer-btn focus-mode" style="padding:2px 8px;font-weight:700" @onclick="ToggleFullscreen">
                                            <i class="bi bi-fullscreen-exit"></i> THOÁT TOÀN MÀN HÌNH
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Thanh công cụ hiển thị Layer & Nhãn -->
                            <div class="canvas-controls-bar">
                                <div class="layer-toggles">
                                    <button class="layer-btn focus-mode @(OnlyShowIssues ? "active" : "")" @onclick="() => OnlyShowIssues = !OnlyShowIssues" title="Lọc box liên quan đến candidate cần người review; model disagreement không chứng minh nhãn sai.">
                                        <i class="bi @(OnlyShowIssues ? "bi-funnel-fill" : "bi-funnel")"></i> @(OnlyShowIssues ? "🎯 Chỉ hiện box cần review: BẬT" : "👁️ Hiện tất cả box")
                                    </button>
                                    <button class="layer-btn human @(ShowHumanBoxes ? "active" : "")" @onclick="() => ShowHumanBoxes = !ShowHumanBoxes" title="Ẩn/Hiện Box của người gán nhãn (Màu xanh)">
                                        <span class="dot-human"></span> Box của người (@HumanBoxCount)
                                    </button>
                                    <button class="layer-btn model @(ShowModelBoxes ? "active" : "")" @onclick="() => ShowModelBoxes = !ShowModelBoxes" title="Ẩn/Hiện Box của AI (Màu tím)">
                                        <span class="dot-model"></span> Box của AI (@ModelBoxCount)
                                    </button>
                                    <button class="layer-btn issues @(ShowIssueBoxes ? "active" : "")" @onclick="() => ShowIssueBoxes = !ShowIssueBoxes" title="Ẩn/Hiện Box cần review (Khác biệt giữa Người và AI - Viền đỏ nét đứt)">
                                        <span class="dot-issue"></span> Box cần review (@IssueBoxCount)
                                    </button>
                                    <button class="layer-btn labels @(ShowTextLabels ? "active" : "")" @onclick="() => ShowTextLabels = !ShowTextLabels" title="Ẩn/Hiện chữ tên nhãn để không bị che khuất ảnh">
                                        <i class="bi @(ShowTextLabels ? "bi-eye" : "bi-eye-slash")"></i> @(ShowTextLabels ? "Tên nhãn: BẬT" : "Tên nhãn: TẮT")
                                    </button>
                                </div>
                                @if (Mode == "segmentation") {
                                    <div>
                                        <button class="layer-btn @(ShowModelMask ? "" : "active")" @onclick="() => ShowModelMask = false">Uploaded Mask</button>
                                        <button class="layer-btn @(ShowModelMask ? "active" : "")" @onclick="ToggleModelMask">AI Model Mask</button>
                                    </div>
                                }
                            </div>

                            <div class="canvas-stage-wrapper">
                                <div class="canvas-stage-inner" style="transform: scale(@ZoomLevel);">
                                    @if (SelectedFrame is not null)
                                    {
                                        var frameW = GetInt(SelectedFrame.Value, "width", 1280);
                                        var frameH = GetInt(SelectedFrame.Value, "height", 720);
                                        var src = GetImageUrl(SelectedFrameName ?? "");
                                        if (src is not null)
                                        {
                                            <img src="@src" alt="Frame @SelectedFrameName" />
                                        }
                                        else
                                        {
                                            <div class="image-placeholder"><i class="bi bi-image"></i><b>Frame preview unavailable</b><small>Add the image in Prepare or put it in the configured local image archive.</small></div>
                                        }

                                        @if (Mode == "segmentation")
                                        {
                                            var mask = GetMaskUrl(SelectedFrame.Value);
                                            if (mask is not null)
                                            {
                                                <img class="segmentation-overlay" src="@mask" alt="@(ShowModelMask ? "Local model prediction overlay" : "Uploaded semantic mask overlay")" />
                                            }
                                            <svg class="annotation-overlay" viewBox="0 0 @frameW @frameH" preserveAspectRatio="xMidYMid meet">
                                                @if (ShowModelBoxes)
                                                {
                                                    @foreach (var prediction in GetArray(SelectedFrame.Value, "model_predictions"))
                                                    {
                                                        var predBox = GetPredictionBox(prediction);
                                                        if (predBox is not null)
                                                        {
                                                            <rect x="@predBox.Value.X" y="@predBox.Value.Y" width="@predBox.Value.W" height="@predBox.Value.H" class="model-box" />
                                                        }
                                                        var polyPts = GetPolygonPoints(prediction);
                                                        if (!string.IsNullOrEmpty(polyPts))
                                                        {
                                                            <polygon points="@polyPts" class="model-polygon-overlay" />
                                                        }
                                                    }
                                                }
                                                @if (ShowIssueBoxes)
                                                {
                                                    @foreach (var issue in SelectedIssues)
                                                    {
                                                        if (IsIssueRejected(issue)) continue;
                                                        var issueId = GetString(issue, "issue_id", "");
                                                        var isSelected = ActiveIssueId == issueId;
                                                        var issueBox = GetIssueBox(issue);
                                                        if (issueBox is not null)
                                                        {
                                                            <rect x="@issueBox.Value.X" y="@issueBox.Value.Y" width="@issueBox.Value.W" height="@issueBox.Value.H" class="issue-box @(isSelected ? "box-highlighted" : "")" @onclick="() => SelectIssue(issue)" />
                                                            @if (isSelected)
                                                            {
                                                                <rect x="@(issueBox.Value.X - 5)" y="@(issueBox.Value.Y - 5)" width="@(issueBox.Value.W + 10)" height="@(issueBox.Value.H + 10)" class="issue-spotlight-ring" />
                                                            }
                                                        }
                                                    }
                                                }
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="annotation-overlay" viewBox="0 0 @frameW @frameH" preserveAspectRatio="xMidYMid meet">
                                                @if (ShowHumanBoxes)
                                                {
                                                    var humanList = GetHumanLabelsList();
                                                    @for (var idx = 0; idx < humanList.Count; idx++)
                                                    {
                                                        var item = humanList[idx];
                                                        var objId = GetString(item, "id", $"h_{idx}");
                                                        if (IsObjectRejected(objId)) continue; // REJECT THÌ MẤT BOX LUÔN!
                                                        var isAccepted = IsObjectAccepted(objId);
                                                        var hasIssue = HasLabelIssue(objId, idx);
                                                        if (OnlyShowIssues && !hasIssue && !isAccepted) continue; // CHỈ HIỆN CÁC BOX CÓ LỖI/NGHI VẤN!

                                                        var isSelected = ActiveObjectId == objId;
                                                        var box = GetAnyBox(item);
                                                        if (box is not null)
                                                        {
                                                            var currentIdx = idx;
                                                            var currentBox = box.Value;
                                                            <rect x="@box.Value.X" y="@box.Value.Y" width="@box.Value.W" height="@box.Value.H"
                                                                  class="label-box @(isAccepted ? "accepted" : "") @(isSelected ? "box-highlighted" : "")"
                                                                  @onclick="() => OnBoxClicked(objId, currentIdx, currentBox)" />
                                                            @if (ShowTextLabels || isSelected)
                                                            {
                                                                <foreignObject x="@box.Value.X" y="@(Math.Max(0, box.Value.Y - 20))" width="160" height="22">
                                                                    <div class="label-text">
                                                                        @(isAccepted ? "✓ " : "")@GetString(item, "category", "object")
                                                                    </div>
                                                                </foreignObject>
                                                            }
                                                        }
                                                    }
                                                }

                                                @if (ShowModelBoxes)
                                                {
                                                    var modelList = GetModelPredictionsList();
                                                    @for (var idx = 0; idx < modelList.Count; idx++)
                                                    {
                                                        var item = modelList[idx];
                                                        var modelId = $"MODEL_{idx}";
                                                        var objId = GetString(item, "id", modelId);
                                                        if (IsPredictionRejected(idx) || IsObjectRejected(objId)) continue; // REJECT THÌ MẤT BOX LUÔN!
                                                        var isAccepted = IsPredictionAccepted(idx) || IsObjectAccepted(objId);
                                                        var hasPredIssue = HasPredictionIssue(idx) || HasLabelIssue(objId, idx);
                                                        if (OnlyShowIssues && !hasPredIssue && !isAccepted) continue; // CHỈ HIỆN MODEL BOX CÓ LỖI/MISSING/CONFLICT!

                                                        var predBox = GetAnyBox(item);
                                                        var isSelected = ActiveObjectId == modelId || ActiveObjectId == objId;
                                                        if (predBox is not null)
                                                        {
                                                            var currentIdx = idx;
                                                            var currentPredBox = predBox.Value;
                                                            <rect x="@predBox.Value.X" y="@predBox.Value.Y" width="@predBox.Value.W" height="@predBox.Value.H"
                                                                  class="@(isAccepted ? "label-box accepted" : "model-box") @(isSelected ? "box-highlighted" : "")"
                                                                  @onclick="() => OnBoxClicked(modelId, currentIdx, currentPredBox)" />
                                                            @if (ShowTextLabels || isSelected)
                                                            {
                                                                <foreignObject x="@predBox.Value.X" y="@predBox.Value.Y" width="190" height="22">
                                                                    <div class="@(isAccepted ? "label-text" : "model-label")">
                                                                        @(isAccepted ? "✓ " : "")@GetString(item, "category", "object")
                                                                    </div>
                                                                </foreignObject>
                                                            }
                                                        }
                                                    }
                                                }

                                                @if (ShowIssueBoxes)
                                                {
                                                    @foreach (var issue in SelectedIssues)
                                                    {
                                                        if (IsIssueRejected(issue)) continue; // REJECT THÌ MẤT BOX LUÔN!
                                                        var issueId = GetString(issue, "issue_id", "");
                                                        var isSelected = ActiveIssueId == issueId;
                                                        var issueBox = GetIssueBox(issue);
                                                        if (issueBox is not null)
                                                        {
                                                            <rect x="@issueBox.Value.X" y="@issueBox.Value.Y" width="@issueBox.Value.W" height="@issueBox.Value.H"
                                                                  class="issue-box @(isSelected ? "box-highlighted" : "")"
                                                                  @onclick="() => SelectIssue(issue)" />
                                                            @if (isSelected)
                                                            {
                                                                <rect x="@(issueBox.Value.X - 5)" y="@(issueBox.Value.Y - 5)" width="@(issueBox.Value.W + 10)" height="@(issueBox.Value.H + 10)" class="issue-spotlight-ring" />
                                                            }
                                                        }
                                                    }
                                                }
                                            </svg>
                                        }
                                    }
                                    else
                                    {
                                        <div class="image-placeholder"><i class="bi bi-image"></i><b>Select a frame</b></div>
                                    }
                                </div>
                            </div>

                            <div class="legend">
                                <span><i class="dot-human"></i> Box của người (Màu xanh)</span>
                                <span><i class="dot-model"></i> Box của AI (Màu tím)</span>
                                <span><i class="dot-issue"></i> Box cần review (Khác biệt giữa Người và AI - Viền đỏ nét đứt)</span>
                                <span class="image-hint">@GetString(SelectedFrame ?? default, "frame_name", "")</span>
                            </div>
                        </section>

                        <section class="issue-panel">
                            <div class="panel-title">
                                <div>
                                    <span class="eyebrow">FINDINGS</span>
                                    <h2>Frame review candidates <span class="issue-count">@SelectedIssues.Count</span></h2>
                                </div>
                                <button class="icon-button" title="Export frame issues" @onclick="() => Step = 2">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </button>
                            </div>

                            @if (SelectedIssues.Count == 0)
                            {
                                <div class="no-issues">
                                    <i class="bi bi-check2-circle"></i>
                                    <b>Không phát hiện lỗi trên frame này</b>
                                    <small>Model AI và rule engine không ghi nhận sai lệch vượt ngưỡng.</small>
                                </div>
                            }
                            else
                            {
                                <div class="issues-list">
                                    @foreach (var issue in SelectedIssues)
                                    {
                                        var issueId = GetString(issue, "issue_id", "");
                                        var severity = GetString(issue, "severity", "MEDIUM");
                                        var decision = GetIssueDecision(issue);
                                        var isSelected = ActiveIssueId == issueId;
                                        <article id="@($"issue-card-{SanitizeId(issueId)}")"
                                                 data-issue-id="@issueId"
                                                 class="issue-card @(isSelected ? "active-card" : "")"
                                                 style="cursor: pointer;"
                                                 @onclick="() => SelectIssue(issue)">
                                            <div class="issue-top">
                                                <span class="severity-tag sev-@severity.ToLowerInvariant()">@severity</span>
                                            </div>
                                            <h3 class="issue-title-short">@FormatIssueTitle(issue)</h3>
                                            <p class="issue-expl-short">@FormatCleanExplanation(issue)</p>
                                            @if (!string.IsNullOrWhiteSpace(GetString(issue, "action", "")))
                                            {
                                                <div class="issue-action-chip">
                                                    <i class="bi bi-lightbulb-fill"></i> <span>@GetString(issue, "action", "")</span>
                                                </div>
                                            }
                                            <div class="issue-pills">
                                                <span class="pill-badge pill-obj"><i class="bi bi-bounding-box"></i> @GetString(issue, "category", "Object")</span>
                                                <span class="pill-badge pill-id">#@GetString(issue, "object_id", "—")</span>
                                                @if (GetString(issue, "iou", "") is var iou && !string.IsNullOrEmpty(iou))
                                                {
                                                    <span class="pill-badge pill-iou">IoU: @iou</span>
                                                }
                                            </div>
                                            @if (GetString(issue, "guideline_rule", "") is var gRule && !string.IsNullOrWhiteSpace(gRule) && !gRule.Contains("Review against team guideline") && !gRule.Contains("Review against standard dataset rules"))
                                            {
                                                <div class="issue-guideline-compact">
                                                    <i class="bi bi-journal-bookmark"></i> <span>@gRule</span>
                                                </div>
                                            }
                                            <div class="issue-footer-actions">
                                                <button class="text-button" @onclick="() => CopyIssue(issue)" @onclick:stopPropagation="true"><i class="bi bi-clipboard"></i> Copy</button>
                                            </div>

                                            <!-- Nút bấm Acp / Reject thực thi trực tiếp gắn với box -->
                                            <div class="decision-card-actions" @onclick:stopPropagation="true">
                                                @if (decision == "confirmed")
                                                {
                                                    <span class="decision-badge-acp"><i class="bi bi-check-circle-fill"></i> ĐÃ GIỮ LẠI (ACP)</span>
                                                    <button class="btn-undo" @onclick="() => UndoIssueDecision(issue)">Khôi phục</button>
                                                }
                                                else if (decision == "rejected")
                                                {
                                                    <span class="decision-badge-rej"><i class="bi bi-x-circle-fill"></i> ĐÃ XÓA BOX (REJECT)</span>
                                                    <button class="btn-undo" @onclick="() => UndoIssueDecision(issue)">Khôi phục</button>
                                                }
                                                else
                                                {
                                                    <button class="btn-acp" title="Đồng ý - Giữ nguyên box trên ảnh" @onclick="() => AcceptIssue(issue)">
                                                        <i class="bi bi-check-lg"></i> Giữ lại (Acp)
                                                    </button>
                                                    <button class="btn-rej" title="Từ chối - Xóa lập tức box khỏi ảnh" @onclick="() => RejectIssue(issue)">
                                                        <i class="bi bi-trash"></i> Xóa box (Reject)
                                                    </button>
                                                }
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                <div class="cvat-connect">
    <div class="cvat-heading">
        <span class="cvat-icon"><i class="bi bi-link-45deg"></i></span>
        <span>
            <b>GỬI ISSUE ĐÃ CHỌN LÊN CVAT</b>
            <small>Tạo CVAT issues có frame và vị trí bằng frame map. Có thể tùy chọn gửi candidate chưa Confirm và đổi Stage/State của Job; hãy kiểm tra Job, mapping và tuỳ chọn trước khi gửi. Không sửa annotation.</small>
        </span>
        <span class="coming-soon" style="background:#1e1b4b;color:#a5b4fc;border:1px solid #4338ca">@CvatStateLabel</span>
    </div>

    <div style="margin-top: 14px;">
        <label style="color:#94a3b8;font-size:10px;margin-bottom:4px;display:block">
            <i class="bi bi-list-task"></i> Chọn nhanh Job từ CVAT:
        </label>
        <select class="cvat-job-select" @onchange="OnJobSelected">
            <option value="0">-- Chọn Job từ danh sách CVAT (tự động nạp Task & Frame map) --</option>
            @foreach (var job in CvatJobList)
            {
                var jId = GetInt(job, "id", 0);
                var tName = GetString(job, "task_name", "Task");
                var fCount = GetInt(job, "frame_count", 0);
                var jState = GetString(job, "state", "in progress");
                var jStage = GetString(job, "stage", "annotation");
                <option value="@jId" selected="@(CvatJobId == jId)">Job #@jId · @tName (Số frame: @fCount | Stage: @jStage | State: @jState)</option>
            }
        </select>
    </div>

    <div class="cvat-fields">
        <label>
            CVAT Job ID
            <input type="number" min="1" @bind="CvatJobId" placeholder="Nhập Job ID" />
        </label>
        <label>
            First frame offset
            <input type="number" min="0" @bind="CvatFrameOffset" />
        </label>
        <label>
            Assignee user ID (tùy chọn)
            <input type="number" min="0" @bind="CvatAssigneeId" placeholder="User ID" />
        </label>
        <label class="compact-upload" for="cvat-map-file">
            <InputFile id="cvat-map-file" OnChange="OnCvatMappingSelected" accept=".csv,.json,application/json,text/csv" />
            <i class="bi bi-file-earmark-spreadsheet"></i>
            <span>@(CvatMappingFileName ?? "Nạp file frame map tùy chỉnh")</span>
            <small>@(CvatFrameMap.Count > 0 ? $"{CvatFrameMap.Count} frames đã map" : "Tự động lấy từ metadata job")</small>
        </label>
        <button class="outline-button" disabled="@IsBusy" @onclick="LoadCvatFrameMap">
            <i class="bi bi-arrow-repeat"></i> Nạp Frame Map từ CVAT
        </button>
        <button class="outline-button" disabled="@IsBusy" @onclick="LoadCvatJobs">
            <i class="bi bi-arrow-clockwise"></i> Làm mới danh sách Job
        </button>
    </div>

    <div class="cvat-options-grid">
        <label>
            <input type="checkbox" @bind="UpdateJobStateOnReturn" />
            <b>Đổi trạng thái Job khi trả về (Update Stage/State)</b>
        </label>
        <label>
            <input type="checkbox" @bind="IncludeAllUnreviewed" />
            <span>Đẩy toàn bộ @IssueCount issue phát hiện (không chỉ các issue đã bấm Confirm)</span>
        </label>
        <label>
            <span>Target Stage:</span>
            <select @bind="TargetStage">
                <option value="annotation">annotation (Trả về cho annotator)</option>
                <option value="validation">validation (Chờ kiểm tra lại)</option>
                <option value="acceptance">acceptance (Nghiệm thu)</option>
            </select>
        </label>
        <label>
            <span>Target State:</span>
            <select @bind="TargetState">
                <option value="rejected">rejected (Từ chối / Cần sửa lỗi)</option>
                <option value="in progress">in progress (Đang thực hiện)</option>
                <option value="completed">completed (Đã xong)</option>
            </select>
        </label>
    </div>

    @if (CvatFrameMap.Count == 0)
    {
        <label class="cvat-confirm">
            <input type="checkbox" @bind="ConfirmOffsetMapping" /> Tôi xác nhận thứ tự frame trong QC khớp với frame offset của CVAT Job.
        </label>
    }

    <div class="cvat-buttons">
        <button class="primary-button btn-return-cvat" disabled="@IsBusy" @onclick="() => PushCvatIssues(true)">
            <i class="bi bi-arrow-return-left"></i> ⚡ @(UpdateJobStateOnReturn ? "TRẢ JOB" : "ĐẨY ISSUES") #@CvatJobId @(UpdateJobStateOnReturn ? "VỀ CVAT KÈM ISSUES" : "LÊN CVAT") (@CvatPushIssueCount issues)
        </button>
        <button class="outline-button" disabled="@IsBusy" @onclick="() => PushCvatIssues(false)">
            <i class="bi bi-send"></i> Chỉ đẩy Issues (Giữ nguyên trạng thái Job) (@CvatPushIssueCount)
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(CvatOperationMessage))
    {
        <div class="status-message @(CvatOperationHasError ? "error" : "")">
            <i class="bi @(CvatOperationHasError ? "bi-exclamation-circle" : "bi-check-circle")"></i> @CvatOperationMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(CvatJobResultUrl))
    {
        <div class="cvat-result-card">
            <div class="cvat-result-head">
                <span class="@(CvatOperationSucceeded ? "cvat-success-icon" : "cvat-warning-icon")"><i class="bi @(CvatOperationSucceeded ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i></span>
                <div>
                    <h4>@(CvatOperationSucceeded ? "CVAT operation completed" : "CVAT operation partially failed")</h4>
                    <p>Job ID: <b>#@CvatJobId</b> · Stage: <b>@CvatResultStage</b> · State: <b>@CvatResultState</b></p>
                </div>
            </div>
            <div class="cvat-result-actions">
                <a href="@CvatJobResultUrl" target="_blank" class="primary-button cvat-open-btn">
                    <i class="bi bi-box-arrow-up-right"></i> Mở Job đã xác minh trên CVAT
                </a>
            </div>
        </div>
    }

    <small class="cvat-help">
        CVAT kết nối qua <code>CVAT_URL</code> và <code>CVAT_ACCESS_TOKEN</code> trong môi trường backend. Issue ghi kèm frame, vị trí bằng chứng, nội dung và guideline citation; cần kiểm tra đúng job/frame map trước khi gửi.
    </small>
</div>
                }
            }
            else
            {
                <section class="welcome-row"><div><div class="eyebrow">DELIVERY / REPORTS</div><h1>Export review results</h1><p>Download the QC report and corrected guideline revision for your team.</p></div><span class="step-counter">03 <i>/ 03</i></span></section>
                @if (Frames.Count == 0) { <div class="empty-state"><span class="empty-icon"><i class="bi bi-file-earmark-bar-graph"></i></span><h2>Nothing to export</h2><p>Run QC on a dataset first.</p><button class="primary-button" @onclick="() => Step = 0">Prepare dataset <i class="bi bi-arrow-right"></i></button></div> }
                else { <div class="export-summary"><span class="export-icon"><i class="bi bi-clipboard2-check"></i></span><div><span class="eyebrow">QC RUN READY</span><h2>@LabelFileName</h2><p>@Frames.Count frames · @IssueCount model/rule candidates · @ConfirmedIssueCount confirmed by reviewer · guideline v@(GetInt(ResultRoot, "guideline_version", 0))</p></div><span class="run-badge"><i class="bi bi-check-circle"></i> Analysis complete</span></div><div class="status-message"><i class="bi bi-info-circle"></i> @ModelStatusText. Model differences are review candidates, not automatic label corrections. Guideline provenance: @GetString(ResultRoot, "guideline_sha256", "no active guideline hash recorded").</div><div class="export-grid"><article class="export-card"><span class="export-card-icon violet"><i class="bi bi-filetype-md"></i></span><h2>Reviewer feedback</h2><p>Markdown report grouped by frame with evidence, decisions and guideline context.</p><button class="primary-button" @onclick="ExportFeedback"><i class="bi bi-download"></i> Download .md</button></article><article class="export-card"><span class="export-card-icon mint"><i class="bi bi-filetype-csv"></i></span><h2>@(Mode == "segmentation" ? "Per-class IoU & issue register" : "Issue register")</h2><p>CSV includes frame, class, model comparison, severity, decision, and guideline citation.</p><button class="outline-button" @onclick="ExportCsv"><i class="bi bi-download"></i> Download .csv</button></article><article class="export-card"><span class="export-card-icon amber"><i class="bi bi-journal-arrow-down"></i></span><h2>Guideline update draft</h2><p>Starts from the current text and proposes clauses only from issues you confirmed. Draft is not activated.</p><button class="outline-button" @onclick="ExportGuideline"><i class="bi bi-download"></i> Generate draft .md</button></article></div> }
            }
        </main>
    </div>
</div>

@if (GuidelineOpen)
{
    <div class="modal-scrim" @onclick="() => GuidelineOpen = false"><section class="guideline-modal" @onclick:stopPropagation="true"><div class="modal-head"><div><span class="eyebrow">WORKSPACE POLICY</span><h2>Search & edit guideline</h2></div><button class="icon-button" @onclick="() => GuidelineOpen = false"><i class="bi bi-x-lg"></i></button></div><label class="guideline-search">Find a clause<input @bind="GuidelineSearch" placeholder="class, threshold, attribute…" /></label>@if (GuidelineMatches.Any()) { <div class="guideline-matches">@foreach (var match in GuidelineMatches) { <div>@match</div> }</div> }<textarea @bind="GuidelineText" spellcheck="false"></textarea><div class="modal-foot"><span>@GuidelineText.Length characters · versioned in local workspace</span><button class="outline-button" @onclick="() => SaveGuidelineDraft()">Save draft</button><button class="primary-button" @onclick="() => SaveGuidelineDraft(true)">Activate for next run</button></div></section></div>
}

@code {
    private string Mode = "bbox";
    private int Step;
    private bool IsBusy;
    private bool ApiOnline;
    private bool IsConnecting;
    private string ModelsMode = "disabled";
    private bool HasError;
    private string? StatusMessage;
    private string? LabelFileName;
    private string? GuidelineFileName;
    private string? ProfileFileName;
    private JsonElement? ProfileJson;
    private string WorkspaceName = "Local workspace";
    private string? WorkspaceId;
    private bool ShowModelMask = true;
    private double ZoomLevel = 1.0;
    private bool IsFullscreen = false;
    private bool OnlyShowIssues = false;
    private bool SwapHumanAndModel = false;
    private bool ShowHumanBoxes = true;
    private bool ShowModelBoxes = true;
    private bool ShowIssueBoxes = true;
    private bool ShowTextLabels = false;
    private string? ActiveIssueId;
    private string? ActiveObjectId;
    private string? SelectedFrameName;
    private string QueueFilter = "all";
    private JsonElement? LabelsJson;
    private JsonElement? SelectedFrame;
    private JsonElement ResultRoot;
    private List<JsonElement> Frames = new();
    private Dictionary<string, string> ImageFiles = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> MaskFiles = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> IndexMaskFiles = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> IssueDecisions = new(StringComparer.Ordinal);
    private string GuidelineText = "";
    private string GuidelineSearch = "";
    private IEnumerable<string> GuidelineMatches => string.IsNullOrWhiteSpace(GuidelineSearch) ? Enumerable.Empty<string>() : GuidelineText.Split('\n').Where(line => line.Contains(GuidelineSearch, StringComparison.OrdinalIgnoreCase)).Take(20);
    private bool GuidelineOpen;
    private JsonElement? TaxonomyAlignment;
    private int CvatJobId;
    private int CvatFrameOffset;
    private int CvatAssigneeId;
    private string CvatUrl = "https://app.cvat.ai";
    private string CvatAccessToken = "";
    private string CvatActiveToken = "";
    private string? CvatUsername;
    private string? CvatVersion;
    private bool IsCvatAi => CvatUrl.Contains("cvat.ai", StringComparison.OrdinalIgnoreCase);
    private bool IsLocalCvat => CvatUrl.Contains("localhost", StringComparison.OrdinalIgnoreCase) || CvatUrl.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase);
    private void SelectCvatAiPreset() { CvatUrl = "https://app.cvat.ai"; }
    private void SelectLocalCvatPreset() { CvatUrl = "http://127.0.0.1:8080"; }
    private string? CvatConfigMessage;
    private bool CvatConfigHasError;
    private bool IsCvatConfigSaving;
    private bool CvatReachable;
    private string? CvatConnectionDetail;
    private string? CvatMappingFileName;
    private Dictionary<string, int> CvatFrameMap = new(StringComparer.OrdinalIgnoreCase);
    private bool ConfirmOffsetMapping;
    private string CvatStateLabel = "CHECKING CVAT";
    private List<JsonElement> CvatJobList = new();
    private List<JsonElement> ModelProviders = new();
    private bool UseGemini;
    private bool GeminiConfigured;
    private string GeminiModel = "gemini-3.8-flash";
    private int GeminiFrameLimit = 10;
    private string? CvatJobResultUrl;
    private string? CvatOperationMessage;
    private bool CvatOperationHasError;
    private string CvatResultStage = "unchanged";
    private string CvatResultState = "unchanged";
    private bool CvatOperationSucceeded;
    private string? CvatSelectedJobUrl
    {
        get
        {
            var job = CvatJobList.FirstOrDefault(item => GetInt(item, "id", 0) == CvatJobId);
            var url = GetString(job, "url", "");
            return Uri.TryCreate(url, UriKind.Absolute, out var uri)
                && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? uri.ToString()
                : null;
        }
    }
    private string TargetStage = "annotation";
    private string TargetState = "rejected";
    private bool IncludeAllUnreviewed = true;
    private bool UpdateJobStateOnReturn = true;
    private List<JsonElement> SelectedIssues => SelectedFrame is null ? new() : GetArray(SelectedFrame.Value, "errors");
    private IEnumerable<JsonElement> VisibleFrames => Frames.Where(f => QueueFilter == "all" || (QueueFilter == "review" ? GetInt(f, "priority_rank", 4) < 4 : GetInt(f, "priority_rank", 4) == 4));
    private int ReviewCount => Frames.Count(f => GetInt(f, "priority_rank", 4) < 4);
    private int PassCount => Frames.Count - ReviewCount;
    private int IssueCount => Frames.Sum(f => GetArray(f, "errors").Count);
    private int ConfirmedIssueCount => Frames.Sum(f => GetArray(f, "errors").Count(i => IssueDecisions.GetValueOrDefault(GetString(i, "issue_id", ""), GetString(i, "review_status", "pending")) == "confirmed"));
    private int CvatPushIssueCount => Frames.Sum(f => GetArray(f, "errors").Count(i =>
    {
        var decision = GetIssueDecision(i);
        return decision != "rejected" && decision != "dismissed" && (IncludeAllUnreviewed || decision == "confirmed");
    }));
    private int RejectedIssueCount => Frames.Sum(f => GetArray(f, "errors").Count(i => {
        var d = IssueDecisions.GetValueOrDefault(GetString(i, "issue_id", ""), GetString(i, "review_status", "pending"));
        return d == "rejected" || d == "dismissed";
    }));
    private int TotalDecidedCount => ConfirmedIssueCount + RejectedIssueCount;
    private List<JsonElement> GetHumanLabelsList() => SelectedFrame is null ? new() : SwapHumanAndModel ? GetArray(SelectedFrame.Value, "model_predictions") : GetArray(SelectedFrame.Value, "labels");
    private List<JsonElement> GetModelPredictionsList() => SelectedFrame is null ? new() : SwapHumanAndModel ? GetArray(SelectedFrame.Value, "labels") : GetArray(SelectedFrame.Value, "model_predictions");
    private int HumanBoxCount => SelectedFrame is null ? 0 : GetHumanLabelsList().Select((l, idx) => (l, idx)).Count(t => {
        var oid = GetString(t.l, "id", $"h_{t.idx}");
        return !IsObjectRejected(oid) && (!OnlyShowIssues || HasLabelIssue(oid, t.idx) || IsObjectAccepted(oid));
    });
    private int ModelBoxCount => SelectedFrame is null ? 0 : GetModelPredictionsList().Select((p, idx) => (p, idx)).Count(t => {
        var oid = GetString(t.p, "id", $"MODEL_{t.idx}");
        return !IsPredictionRejected(t.idx) && !IsObjectRejected(oid) && (!OnlyShowIssues || HasPredictionIssue(t.idx) || HasLabelIssue(oid, t.idx) || IsPredictionAccepted(t.idx) || IsObjectAccepted(oid));
    });
    private int IssueBoxCount => SelectedIssues.Count(i => !IsIssueRejected(i));
    private int FrameCount => LabelsJson is null ? 0 : ProfileJson is not null && GetString(ProfileJson.Value, "annotation_format", "") == "coco" ? GetArray(LabelsJson.Value, "images").Count : LabelsJson.Value.ValueKind == JsonValueKind.Array ? LabelsJson.Value.GetArrayLength() : GetArray(LabelsJson.Value, "data").Count;
    private string SelectedModelText
    {
        get
        {
            var id = Mode == "segmentation" ? "segmentation" : "bbox";
            var provider = ModelProviders.FirstOrDefault(p => GetString(p, "id", "") == id);
            if (provider.ValueKind != JsonValueKind.Object) return $"{id} provider status unavailable";
            if (!GetBool(provider, "available")) return $"{id} provider unavailable";
            return $"{GetString(provider, "name", id)} · {GetString(provider, "device", "device unknown")}";
        }
    }
    private string ModelStatusText => ModelsMode is "local" or "remote" ? SelectedModelText : ModelsMode == "simulated" ? "Simulated mode · demo only" : "Rules · local models unavailable";
    private HttpClient Api => HttpFactory.CreateClient("qc");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await RefreshServices();
    }

    private async Task RefreshServices()
    {
        if (IsConnecting) return;
        IsConnecting = true;
        try
        {
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                var health = await Api.GetFromJsonAsync<JsonElement>("/api/health", timeout.Token);
                ApiOnline = GetString(health, "status", "") == "ok";
                ModelsMode = GetString(health, "models_mode", "disabled");
            }
            catch { ApiOnline = false; }

            if (!ApiOnline)
            {
                await InvokeAsync(StateHasChanged);
                return;
            }

            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
                var modelInfo = await Api.GetFromJsonAsync<JsonElement>("/api/models", timeout.Token);
                ModelProviders = GetArray(modelInfo, "providers");
                GeminiConfigured = GetBool(GetObject(modelInfo, "gemini"), "configured");
                GeminiModel = GetString(GetObject(modelInfo, "gemini"), "model", GeminiModel);
                UseGemini = false;
            }
            catch { ModelProviders.Clear(); }
            await InvokeAsync(StateHasChanged);

            await LoadDefaultGuideline();
            await RefreshTaxonomyAlignment();
            await InvokeAsync(StateHasChanged);

            await RefreshCvatConnection();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            IsConnecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDefaultGuideline()
    {
        if (!string.IsNullOrWhiteSpace(GuidelineText)) return;
        try
        {
            var res = await Api.GetFromJsonAsync<JsonElement>("/api/guideline/default");
            var defaultText = GetString(res, "guideline_text", GetString(res, "raw_text", ""));
            if (!string.IsNullOrWhiteSpace(defaultText))
            {
                GuidelineText = defaultText;
                GuidelineFileName = null; // null indicates system default
            }
        }
        catch { }
    }

    private async Task RefreshTaxonomyAlignment()
    {
        try
        {
            var datasetClasses = ExtractDatasetClasses();
            var payload = new
            {
                dataset_classes = datasetClasses,
                guideline_text = GuidelineText,
                mode = Mode
            };
            using var res = await Api.PostAsJsonAsync("/api/guideline/align-taxonomy", payload);
            if (res.IsSuccessStatusCode)
            {
                var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                if (doc.RootElement.TryGetProperty("alignment", out var alignElem) && alignElem.ValueKind == JsonValueKind.Object)
                {
                    TaxonomyAlignment = alignElem.Clone();
                }
                else
                {
                    TaxonomyAlignment = doc.RootElement.Clone();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private List<string> ExtractDatasetClasses()
    {
        var classes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (LabelsJson is null) return classes.ToList();

        if (LabelsJson.Value.ValueKind == JsonValueKind.Array)
        {
            foreach (var frame in LabelsJson.Value.EnumerateArray())
            {
                if (frame.TryGetProperty("labels", out var lbls) && lbls.ValueKind == JsonValueKind.Array)
                {
                    foreach (var lbl in lbls.EnumerateArray())
                    {
                        if (lbl.TryGetProperty("category", out var cat) && !string.IsNullOrWhiteSpace(cat.GetString()))
                        {
                            classes.Add(cat.GetString()!);
                        }
                    }
                }
            }
        }
        else if (LabelsJson.Value.ValueKind == JsonValueKind.Object)
        {
            if (LabelsJson.Value.TryGetProperty("categories", out var cats) && cats.ValueKind == JsonValueKind.Array)
            {
                foreach (var c in cats.EnumerateArray())
                {
                    if (c.TryGetProperty("name", out var n) && !string.IsNullOrWhiteSpace(n.GetString()))
                        classes.Add(n.GetString()!);
                }
            }
            if (LabelsJson.Value.TryGetProperty("data", out var data) && data.ValueKind == JsonValueKind.Array)
            {
                foreach (var frame in data.EnumerateArray())
                {
                    if (frame.TryGetProperty("labels", out var lbls) && lbls.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var lbl in lbls.EnumerateArray())
                        {
                            if (lbl.TryGetProperty("category", out var cat) && !string.IsNullOrWhiteSpace(cat.GetString()))
                                classes.Add(cat.GetString()!);
                        }
                    }
                }
            }
        }
        return classes.ToList();
    }

    private HttpRequestMessage CreateCvatRequest(HttpMethod method, string path, object? jsonBody = null)
    {
        var req = new HttpRequestMessage(method, path);
        if (!string.IsNullOrWhiteSpace(CvatUrl))
        {
            req.Headers.TryAddWithoutValidation("X-CVAT-Url", CvatUrl.Trim());
        }
        var token = !string.IsNullOrWhiteSpace(CvatActiveToken) ? CvatActiveToken : CvatAccessToken;
        if (!string.IsNullOrWhiteSpace(token))
        {
            req.Headers.TryAddWithoutValidation("X-CVAT-Token", token.Trim());
        }
        if (jsonBody != null)
        {
            req.Content = JsonContent.Create(jsonBody);
        }
        return req;
    }

    private async Task RefreshCvatConnection()
    {
        try
        {
            using var req = CreateCvatRequest(HttpMethod.Get, "/api/cvat/status");
            using var res = await Api.SendAsync(req);
            if (!res.IsSuccessStatusCode)
            {
                CvatReachable = false;
                CvatJobList.Clear();
                CvatStateLabel = $"CVAT HTTP {(int)res.StatusCode}";
                CvatConnectionDetail = await res.Content.ReadAsStringAsync();
                return;
            }
            using var cvat = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            CvatReachable = GetBool(cvat.RootElement, "reachable");
            CvatConnectionDetail = CvatReachable ? null : GetString(cvat.RootElement, "detail", "CVAT connection failed.");
            CvatUsername = GetString(cvat.RootElement, "username", "");
            CvatVersion = GetString(cvat.RootElement, "version", "");
            if (CvatReachable)
            {
                var userSuffix = !string.IsNullOrWhiteSpace(CvatUsername) ? $" · {CvatUsername}" : "";
                CvatStateLabel = $"CONNECTED{(IsCvatAi ? " (cvat.ai)" : "")}{userSuffix}";
                await LoadCvatJobs();
            }
            else
            {
                CvatJobList.Clear();
                CvatStateLabel = GetBool(cvat.RootElement, "configured") ? "TOKEN / NETWORK ISSUE" : "TOKEN REQUIRED";
            }
        }
        catch (Exception ex)
        {
            CvatReachable = false;
            CvatJobList.Clear();
            CvatStateLabel = "CVAT STATUS UNKNOWN";
            CvatConnectionDetail = $"Could not read CVAT status: {ex.Message}";
        }
    }

    private void SetMode(string mode)
    {
        if (IsBusy) return;
        if (Mode == mode) return;
        Mode = mode;
        LabelsJson = null; LabelFileName = null; ProfileJson = null; ProfileFileName = null; Frames.Clear(); SelectedFrame = null; SelectedFrameName = null;
        ImageFiles.Clear(); MaskFiles.Clear(); IndexMaskFiles.Clear(); IssueDecisions.Clear(); WorkspaceId = null; QueueFilter = "all"; Step = 0; ShowModelMask = false;
        StatusMessage = mode == "segmentation" ? "Segmentation dùng manifest ảnh/mask riêng; hãy tải lại đúng một pack segmentation." : "BBox dùng annotations cho detection; hãy tải lại pack BBox.";
        HasError = false;
    }
    private async Task OnProfileSelected(InputFileChangeEventArgs e)
    {
        try { await using var stream = e.File.OpenReadStream(2 * 1024 * 1024); using var doc = await JsonDocument.ParseAsync(stream); if (doc.RootElement.ValueKind != JsonValueKind.Object) throw new InvalidOperationException("Profile must be a JSON object."); ProfileJson = doc.RootElement.Clone(); ProfileFileName = e.File.Name; StatusMessage = $"Loaded dataset profile {e.File.Name}."; HasError = false; }
        catch (Exception ex) { ProfileJson = null; StatusMessage = $"Could not read dataset profile: {ex.Message}"; HasError = true; }
    }
    private async Task OnLabelsSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(32 * 1024 * 1024);
            using var doc = await JsonDocument.ParseAsync(stream);
            if (IsCvatLabelDefinition(doc.RootElement))
            {
                LabelsJson = null;
                LabelFileName = null;
                StatusMessage = $"'{file.Name}' contains CVAT label definitions, not frame annotations. Upload frame-level annotations to run QC; use Local CVAT Review to open an existing CVAT job.";
                HasError = true;
                return;
            }

            LabelsJson = doc.RootElement.Clone();
            LabelFileName = file.Name;
            if (WorkspaceName == "Local workspace") WorkspaceName = Path.GetFileNameWithoutExtension(file.Name);
            StatusMessage = $"Đã đọc {FrameCount} frame từ {file.Name}.";
            HasError = false;
            await RefreshTaxonomyAlignment();
        }
        catch (Exception ex) { LabelsJson = null; StatusMessage = $"Không đọc được file nhãn JSON: {ex.Message}"; HasError = true; }
    }
    private static bool IsCvatLabelDefinition(JsonElement root)
    {
        if (root.ValueKind != JsonValueKind.Array || root.GetArrayLength() == 0) return false;
        return root.EnumerateArray().All(label =>
            label.ValueKind == JsonValueKind.Object
            && label.TryGetProperty("name", out var name) && name.ValueKind == JsonValueKind.String
            && label.TryGetProperty("type", out _)
            && label.TryGetProperty("attributes", out var attributes) && attributes.ValueKind == JsonValueKind.Array);
    }
    private async Task OnGuidelineSelected(InputFileChangeEventArgs e)
    {
        try { await using var stream = e.File.OpenReadStream(4 * 1024 * 1024); using var reader = new StreamReader(stream); GuidelineText = await reader.ReadToEndAsync(); GuidelineFileName = e.File.Name; await SaveGuidelineDraft(true); await RefreshTaxonomyAlignment(); }
        catch (Exception ex) { StatusMessage = $"Không đọc được guideline: {ex.Message}"; HasError = true; }
    }
    private async Task EnsureWorkspace()
    {
        var profile = ProfileJson is null ? new Dictionary<string, object?>() : JsonSerializer.Deserialize<Dictionary<string, object?>>(ProfileJson.Value.GetRawText()) ?? new();
        profile["task_type"] = Mode == "segmentation" ? "semantic_segmentation" : "bbox";
        profile.TryAdd("annotation_format", "bdd100k");
        if (WorkspaceId is null)
        {
            using var response = await Api.PostAsJsonAsync("/api/workspaces", new { name = WorkspaceName, profile });
            var text = await response.Content.ReadAsStringAsync(); if (!response.IsSuccessStatusCode) throw new InvalidOperationException(text);
            using var doc = JsonDocument.Parse(text); WorkspaceId = GetString(GetProperty(doc.RootElement, "workspace"), "id", "");
        }
        else
        {
            using var response = await Api.PutAsJsonAsync($"/api/workspaces/{WorkspaceId}", new { profile });
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(await response.Content.ReadAsStringAsync());
        }
    }
    private async Task SaveGuidelineDraft(bool activate = false, bool throwOnFailure = false)
    {
        if (string.IsNullOrWhiteSpace(GuidelineText)) return;
        try
        {
            await EnsureWorkspace();
            using var res = await Api.PostAsJsonAsync("/api/guideline", new { workspace_id = WorkspaceId, guideline_text = GuidelineText, activate });
            var body = await res.Content.ReadAsStringAsync(); if (!res.IsSuccessStatusCode) throw new InvalidOperationException(body);
            using var doc = JsonDocument.Parse(body); var version = GetInt(doc.RootElement, "version", 0);
