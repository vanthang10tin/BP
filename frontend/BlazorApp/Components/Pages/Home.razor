    private static string FormatIssueTitle(JsonElement issue)
    {
        var err = GetString(issue, "error_type", "Issue");
        var cat = GetString(issue, "category", "vật thể").Trim();
        var act = GetString(issue, "action", "");
        
        return err switch
        {
            "POSSIBLE_UNLABELED_OBJECT" => $"BỎ SÓT: {cat}",
            "MODEL_CLASS_DISAGREEMENT" => ExtractClassDisagreement(cat, act),
            "GEMINI_ARBITRATED_DISPUTE" => $"TRỌNG TÀI GEMINI: {cat}",
            "SEGMENTATION_CONSENSUS_ERROR" => $"LỆCH MASK: {cat}",
            "ANNOTATION_NOT_CONFIRMED_BY_MODEL" => $"NGHI THỪA: {cat}",
            "DUPLICATE_BOUNDING_BOX" => $"TRÙNG BOX: {cat}",
            "BOX_OUT_OF_BOUNDS" => $"TRÀN KHUNG: {cat}",
            "BOX_INVERTED" => $"NGHỊCH TOẠ ĐỘ: {cat}",
            "BOX_TOO_SMALL" => $"QUÁ NHỎ: {cat}",
            "BOX_DEGENERATE" => $"DỊ DẠNG: {cat}",
            "UNEXPECTED_CATEGORY" => $"CLASS LẠ: {cat}",
            "OCCLUDED_MISMATCH" => $"LỆCH CHE KHUẤT: {cat}",
            "TRUNCATED_MISMATCH" => $"LỆCH CẮT VIỀN: {cat}",
            _ => $"{Humanize(err)}: {cat}"
        };
    }
    private static string ExtractClassDisagreement(string currentCat, string action)
    {
        if (!string.IsNullOrEmpty(action))
        {
            var match = System.Text.RegularExpressions.Regex.Match(action, @"['""]([^'""]+)['""]");
            if (match.Success && !string.Equals(match.Groups[1].Value, currentCat, StringComparison.OrdinalIgnoreCase))
            {
                return $"SAI CLASS: {currentCat} → {match.Groups[1].Value}";
            }
        }
        return $"SAI CLASS: {currentCat}";
    }
    private static string FormatCleanExplanation(JsonElement issue)
    {
        var expl = GetString(issue, "explanation", "");
        if (string.IsNullOrWhiteSpace(expl)) return "Không có mô tả.";
        expl = System.Text.RegularExpressions.Regex.Replace(expl, @"^(Hội đồng:\s*|\[Trọng tài Gemini\]\s*|\[Gemini\]\s*|AI:\s*)", "");
        return expl;
    }
    private static string FormatModelShortName(string raw)
    {
