    private string SanitizeId(string id)
    {
        if (string.IsNullOrEmpty(id)) return "unknown";
        return System.Text.RegularExpressions.Regex.Replace(id, @"[^a-zA-Z0-9_\-]", "_");
    }

    private static double ComputeBoxIoU((double X, double Y, double W, double H) b1, (double X, double Y, double W, double H) b2)
    {
        var x1 = Math.Max(b1.X, b2.X);
        var y1 = Math.Max(b1.Y, b2.Y);
        var x2 = Math.Min(b1.X + b1.W, b2.X + b2.W);
        var y2 = Math.Min(b1.Y + b1.H, b2.Y + b2.H);
        var interW = Math.Max(0.0, x2 - x1);
        var interH = Math.Max(0.0, y2 - y1);
        var interArea = interW * interH;
        var unionArea = (b1.W * b1.H) + (b2.W * b2.H) - interArea;
        return unionArea > 0 ? interArea / unionArea : 0.0;
    }

    private JsonElement? FindIssueForBox(string objId, int idx, (double X, double Y, double W, double H)? box = null)
    {
        if (SelectedIssues.Count == 0) return null;
        var cleanId = objId.StartsWith("obj_") ? objId.Substring(4) : (objId.StartsWith("h_") ? objId.Substring(2) : objId);

        // 1. Khớp chính xác hoặc một phần qua ID
        foreach (var i in SelectedIssues)
        {
            var oid = GetString(i, "object_id", "");
            var issueId = GetString(i, "issue_id", "");
            var cleanOid = oid.StartsWith("obj_") ? oid.Substring(4) : (oid.StartsWith("h_") ? oid.Substring(2) : oid);
            if (!string.IsNullOrEmpty(oid) && (oid == objId || cleanOid == cleanId || cleanOid == objId || oid == cleanId)) return i;
            if (idx >= 0)
            {
                if (oid == $"obj_{idx}" || oid == $"h_{idx}" || cleanOid == idx.ToString()) return i;
                if (issueId.Contains($":obj_{idx}:") || issueId.Contains($":{idx}:")) return i;
            }
            if (!string.IsNullOrEmpty(objId) && issueId.Contains($":{objId}:")) return i;
        }

        // 2. Khớp qua độ chồng lấp không gian (Spatial IoU Overlap)
        if (box.HasValue)
        {
            JsonElement? bestIssue = null;
            double maxIoU = 0.30;
            foreach (var i in SelectedIssues)
            {
                var issueBox = GetIssueBox(i);
                if (issueBox.HasValue)
                {
                    var iou = ComputeBoxIoU(box.Value, issueBox.Value);
                    if (iou > maxIoU)
                    {
                        maxIoU = iou;
                        bestIssue = i;
                    }
                }
            }
            if (bestIssue.HasValue) return bestIssue;
        }

        return null;
    }

