    private void AcceptIssue(JsonElement issue)
    {
        SetIssueDecision(issue, "confirmed");
        var objId = GetString(issue, "object_id", "");
        if (!string.IsNullOrEmpty(objId)) IssueDecisions[objId] = "confirmed";
        ActiveIssueId = GetString(issue, "issue_id", "");
        ActiveObjectId = objId;
    }

    private void RejectIssue(JsonElement issue)
    {
        SetIssueDecision(issue, "rejected");
        var objId = GetString(issue, "object_id", "");
        if (!string.IsNullOrEmpty(objId)) IssueDecisions[objId] = "rejected";
        ActiveIssueId = GetString(issue, "issue_id", "");
        ActiveObjectId = objId;
    }

    private void UndoIssueDecision(JsonElement issue)
    {
        SetIssueDecision(issue, "pending");
        var objId = GetString(issue, "object_id", "");
        if (!string.IsNullOrEmpty(objId)) IssueDecisions.Remove(objId);
    }

    private bool IsObjectRejected(string objectId)
    {
        if (string.IsNullOrEmpty(objectId)) return false;
        if (IssueDecisions.TryGetValue(objectId, out var d) && (d == "rejected" || d == "dismissed")) return true;
        return SelectedIssues.Any(i => {
            var oid = GetString(i, "object_id", "");
            return (oid == objectId || oid.Contains(objectId)) && (GetIssueDecision(i) == "rejected" || GetIssueDecision(i) == "dismissed");
        });
    }

    private bool IsObjectAccepted(string objectId)
    {
        if (string.IsNullOrEmpty(objectId)) return false;
        if (IssueDecisions.TryGetValue(objectId, out var d) && d == "confirmed") return true;
        return SelectedIssues.Any(i => {
            var oid = GetString(i, "object_id", "");
            return (oid == objectId || oid.Contains(objectId)) && GetIssueDecision(i) == "confirmed";
        });
    }

    private bool IsPredictionRejected(int idx)
    {
        var predId = $"MODEL_{idx}";
        if (IssueDecisions.TryGetValue(predId, out var d) && (d == "rejected" || d == "dismissed")) return true;
        return SelectedIssues.Any(i => (GetString(i, "object_id", "") == predId || GetString(i, "issue_id", "").Contains($":prediction:{idx}")) && (GetIssueDecision(i) == "rejected" || GetIssueDecision(i) == "dismissed"));
    }

    private bool IsPredictionAccepted(int idx)
    {
        var predId = $"MODEL_{idx}";
        if (IssueDecisions.TryGetValue(predId, out var d) && d == "confirmed") return true;
        return SelectedIssues.Any(i => (GetString(i, "object_id", "") == predId || GetString(i, "issue_id", "").Contains($":prediction:{idx}")) && GetIssueDecision(i) == "confirmed");
    }

    private bool IsIssueRejected(JsonElement issue)
    {
        var d = GetIssueDecision(issue);
        return d == "rejected" || d == "dismissed";
    }

    private bool IsIssueAccepted(JsonElement issue)
    {
        var d = GetIssueDecision(issue);
        return d == "confirmed";
    }

