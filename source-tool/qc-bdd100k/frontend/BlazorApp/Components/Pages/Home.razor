    private bool HasLabelIssue(string objId, int idx)
    {
        if (SelectedIssues.Count == 0) return false;
        return SelectedIssues.Any(i => {
            var oid = GetString(i, "object_id", "");
            var issueId = GetString(i, "issue_id", "");
            if (!string.IsNullOrEmpty(objId) && (oid == objId || oid.Contains(objId))) return true;
            if (oid == $"obj_{idx}") return true;
            if (!string.IsNullOrEmpty(objId) && issueId.Contains($":{objId}:")) return true;
            if (issueId.Contains($":obj_{idx}:")) return true;
            return false;
        });
    }

    private bool HasPredictionIssue(int idx)
    {
        if (SelectedIssues.Count == 0) return false;
        return SelectedIssues.Any(i => {
            var oid = GetString(i, "object_id", "");
            var issueId = GetString(i, "issue_id", "");
            if (oid == $"MODEL_{idx}") return true;
            if (issueId.Contains($":prediction:{idx}")) return true;
            return false;
        });
    }

