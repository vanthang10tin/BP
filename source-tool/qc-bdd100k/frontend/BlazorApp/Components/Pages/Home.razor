    private async Task LoadQuickDemoPack()
    {
        try
        {
            IsBusy = true;
            StatusMessage = "Đang nạp nhanh bộ dữ liệu demo từ DEMO_PACK...";
            StateHasChanged();

            string? demoDir = null;
            var dir = new DirectoryInfo(Directory.GetCurrentDirectory());
            while (dir != null)
            {
                var candidate = Path.Combine(dir.FullName, "DEMO_PACK", Mode == "segmentation" ? "SEGMENTATION" : "BBOX");
                if (Directory.Exists(candidate))
                {
                    demoDir = candidate;
                    break;
                }
                dir = dir.Parent;
            }

            if (demoDir == null)
            {
                throw new DirectoryNotFoundException("Không tìm thấy thư mục DEMO_PACK trên máy.");
            }

            // 1. Labels
            var jsonPath = Path.Combine(demoDir, "annotations.json");
            if (File.Exists(jsonPath))
            {
                var jsonBytes = await File.ReadAllBytesAsync(jsonPath);
                using var doc = JsonDocument.Parse(jsonBytes);
                LabelsJson = doc.RootElement.Clone();
                LabelFileName = $"annotations.json (DEMO {FrameCount} frames)";
                WorkspaceName = "BDD100K Demo Run";
            }

            // 2. Guideline
            var guidePath = Path.Combine(demoDir, "guideline.md");
            if (File.Exists(guidePath))
            {
                GuidelineText = await File.ReadAllTextAsync(guidePath);
                GuidelineFileName = "guideline.md (DEMO)";
                await SaveGuidelineDraft(true);
            }

            // 3. Images
            var imgDir = Path.Combine(demoDir, "images");
            if (Directory.Exists(imgDir))
            {
                ImageFiles.Clear();
                foreach (var imgFile in Directory.GetFiles(imgDir, "*.jpg"))
                {
                    var fName = Path.GetFileName(imgFile);
                    var b = await File.ReadAllBytesAsync(imgFile);
                    ImageFiles[fName] = $"data:image/jpeg;base64,{Convert.ToBase64String(b)}";
                }
            }

            if (Mode == "segmentation")
            {
                var colorDir = Path.Combine(demoDir, "masks_color");
                if (Directory.Exists(colorDir))
                {
                    MaskFiles.Clear();
                    foreach (var mFile in Directory.GetFiles(colorDir, "*.png"))
                    {
                        var fName = Path.GetFileName(mFile);
                        var b = await File.ReadAllBytesAsync(mFile);
                        MaskFiles[fName] = $"data:image/png;base64,{Convert.ToBase64String(b)}";
                    }
                }
                var indexDir = Path.Combine(demoDir, "masks_index");
                if (Directory.Exists(indexDir))
                {
                    IndexMaskFiles.Clear();
                    foreach (var mFile in Directory.GetFiles(indexDir, "*.png"))
                    {
                        var fName = Path.GetFileName(mFile);
                        var b = await File.ReadAllBytesAsync(mFile);
                        IndexMaskFiles[fName] = $"data:image/png;base64,{Convert.ToBase64String(b)}";
                    }
                }
            }

            StatusMessage = $"⚡ Đã nạp trọn bộ DEMO thành công: {FrameCount} frame, guideline và {ImageFiles.Count} ảnh! Bạn hãy bấm 'Run local QC' bên dưới để bắt đầu.";
            HasError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Lỗi nạp demo: {ex.Message}";
            HasError = true;
        }
        finally
        {
            IsBusy = false;
        }
    }

