    private async Task RunQc()
    {
        if (LabelsJson is null) return;
        IsBusy = true; HasError = false; StatusMessage = null;
        try
        {
            await EnsureWorkspace();
            var data = LabelsJson.Value;
            var images = ImageFiles.ToDictionary(pair => pair.Key, pair => pair.Value);
            var payload = new Dictionary<string, object?> { ["workspace_id"] = WorkspaceId, ["task_type"] = Mode == "segmentation" ? "semantic_segmentation" : "bbox", ["data"] = data, ["images"] = images, ["use_gemini"] = UseGemini, ["gemini_frame_limit"] = Math.Clamp(GeminiFrameLimit, 1, 50) };
            if (Mode == "segmentation")
            {
                var rows = LabelsJson.Value.ValueKind == JsonValueKind.Array ? LabelsJson.Value.EnumerateArray().Select(x => x.Clone()).ToList() : GetArray(LabelsJson.Value, "data");
                foreach (var row in rows)
                {
                    var name = GetString(row, "name", "");
                    var indexPath = GetString(row, "mask_index", "");
                    var colorPath = GetString(row, "mask_color", "");
                    var indexName = Path.GetFileName(indexPath.Replace('/', Path.DirectorySeparatorChar));
                    var colorName = Path.GetFileName(colorPath.Replace('/', Path.DirectorySeparatorChar));
                    if (string.IsNullOrWhiteSpace(name) || !ImageFiles.ContainsKey(name)) throw new InvalidOperationException($"Thiếu ảnh JPG tương ứng cho frame '{name}'. Chọn toàn bộ ảnh images/.");
                    if (string.IsNullOrWhiteSpace(indexName) || !IndexMaskFiles.ContainsKey(indexName)) throw new InvalidOperationException($"Thiếu train-ID mask cho frame '{name}'. Chọn PNG từ masks/index/.");
                    if (string.IsNullOrWhiteSpace(colorName) || !MaskFiles.ContainsKey(colorName)) throw new InvalidOperationException($"Thiếu color mask cho frame '{name}'. Chọn PNG từ masks/color/.");
                }
                payload["masks"] = IndexMaskFiles.ToDictionary(pair => pair.Key, pair => pair.Value);
            }
            using var response = await Api.PostAsJsonAsync("/api/qc/run", payload);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(body);
            using var doc = JsonDocument.Parse(body); ResultRoot = doc.RootElement.Clone(); Frames = GetArray(ResultRoot, "sorted_frames");
            if (Frames.Count == 0) throw new InvalidOperationException("API không trả về frame nào. Kiểm tra profile, taxonomy và mask mapping.");
            IssueDecisions.Clear(); SelectedFrameName = GetString(Frames[0], "frame_name", ""); SelectedFrame = Frames[0]; Step = 1; ApiOnline = true; ShowModelMask = false;
            var models = GetArray(ResultRoot, "models");
            var skipped = GetArray(ResultRoot, "model_skips").Count;
            StatusMessage = UseGemini
                ? $"Đã chạy QC local + Gemini {GeminiModel}: {GetInt(ResultRoot, "model_issues", 0)} candidate issues tổng cộng. Gemini đã kiểm tra {GetInt(GetObject(ResultRoot, "gemini"), "frames_checked", 0)} frame; mọi đề xuất cần người xác nhận. Ảnh và guideline đã được gửi tới Google."
                : Mode == "segmentation"
                ? $"Đã chạy local segmentation: {models.Count} model, {GetInt(ResultRoot, "model_issues", 0)} candidate issue. Macro IoU chỉ là so sánh run này, chưa phải benchmark."
                : $"Đã chạy QC + local detector: {models.Count} model, {GetInt(ResultRoot, "model_issues", 0)} candidate issue; {skipped} frame chưa có ảnh/model result. Candidate cần người xác nhận.";
        }
        catch (Exception ex) { StatusMessage = $"Phân tích thất bại: {ex.Message}"; HasError = true; }
        finally { IsBusy = false; }
    }
