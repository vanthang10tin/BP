    private async Task PushCvatIssues(bool returnJob = true)
    {
        if (CvatJobId <= 0) { StatusMessage = "Vui lòng chọn hoặc nhập CVAT Job ID."; HasError = true; return; }
        var totalAvailable = IncludeAllUnreviewed ? IssueCount : ConfirmedIssueCount;
        if (totalAvailable == 0) { StatusMessage = "Không có issue nào để gửi lên CVAT."; HasError = true; return; }
        IsBusy = true;
        try
        {
            var payload = new
            {
                job_id = CvatJobId,
                frame_offset = CvatFrameOffset,
                frame_map = CvatFrameMap,
                confirm_offset_mapping = ConfirmOffsetMapping || CvatFrameMap.Count > 0,
                assignee_id = CvatAssigneeId > 0 ? CvatAssigneeId : (int?)null,
                sorted_frames = BuildFramesForCvat(),
                update_job_state = returnJob && UpdateJobStateOnReturn,
                target_stage = TargetStage,
                target_state = TargetState,
                include_all_unreviewed = IncludeAllUnreviewed
            };
            using var response = await Api.PostAsJsonAsync("/api/cvat/push-issues", payload);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) throw new InvalidOperationException(body);
            using var result = JsonDocument.Parse(body);
            var created = GetInt(result.RootElement, "created", 0);
            var skipped = GetInt(result.RootElement, "skipped_existing", 0);
            var failed = GetArray(result.RootElement, "failed").Count;
            CvatJobResultUrl = GetString(result.RootElement, "cvat_job_url", $"http://127.0.0.1:8080/jobs/{CvatJobId}");
            var jobStage = GetString(result.RootElement, "job_stage", TargetStage);
            var jobState = GetString(result.RootElement, "job_state", TargetState);
            StatusMessage = returnJob
                ? $"✅ Đã trả Job #{CvatJobId} về CVAT! Tạo {created} issues trên các frame ({skipped} trùng lặp). Job đã chuyển sang Stage: {jobStage}, State: {jobState}."
                : $"CVAT: Tạo {created} issues ({skipped} trùng lặp). Trạng thái job giữ nguyên.";
            HasError = failed > 0;
            CvatStateLabel = returnJob ? $"JOB RETURNED ({jobState.ToUpperInvariant()})" : "PUSH COMPLETE";
        }
        catch (Exception ex) { StatusMessage = $"Không đẩy được issue lên CVAT: {ex.Message}"; HasError = true; CvatStateLabel = "NOT CONNECTED"; }
        finally { IsBusy = false; }
    }
