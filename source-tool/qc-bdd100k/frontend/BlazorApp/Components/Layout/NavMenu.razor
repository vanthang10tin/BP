<MudNavMenu>
    <MudNavLink Icon="@Icons.Material.Filled.Home" Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.FiberNew" Href="/counter" Match="NavLinkMatch.Prefix">Counting</MudNavLink>
    <MudNavGroup Icon="@Icons.Material.Filled.Settings"Title="Settings" Expanded="true">
        <MudNavLink Icon="@Icons.Material.Filled.WbSunny" Href="/weather" Match="NavLinkMatch.Prefix">Weather</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Error" Href="/not-found" Match="NavLinkMatch.Prefix">Not Found</MudNavLink>
    </MudNavGroup>
    <MudNavLink Icon="@Icons.Material.Filled.Checklist" Href="/todo" Match="NavLinkMatch.Prefix">To-do list</MudNavLink>
</MudNavMenu>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

}

